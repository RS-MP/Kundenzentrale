<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Telerik Document Processing: Offline-Pakete vom Entwicklungsleiter
         (TelerikPDF ist gitignored — Ordner + telerik-license.txt im Repo-Root
         müssen auf dem Build-Rechner vorhanden sein). -->
    <add key="telerik-lokal" value="TelerikPDF/pakete" />
  </packageSources>
</configuration>
