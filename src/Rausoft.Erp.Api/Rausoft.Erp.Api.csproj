<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net10.0-windows wegen Telerik Document Processing (Windows-Pakete);
         Betrieb ist ohnehin ausschließlich Windows Server (IIS, DPAPI). -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.14.2" />
    <!-- PDF-Erzeugung (FEEDBACK Nr. 14 Stufe 1b): docx → PDF + Signatur/Metadaten -->
    <PackageReference Include="Telerik.Windows.Documents.Flow.FormatProviders.Pdf" Version="2026.3.923" />
    <PackageReference Include="Telerik.Windows.Documents.Fixed" Version="2026.3.923" />
  </ItemGroup>

  <ItemGroup>
    <!-- Die Telerik-Windows-Pakete nutzen WPF-Typen (System.Windows.Rect) —
         auf dem Server muss zusätzlich die .NET Desktop Runtime installiert sein. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rausoft.Erp.Data\Rausoft.Erp.Data.csproj" />
    <ProjectReference Include="..\Rausoft.Erp.Dtos\Rausoft.Erp.Dtos.csproj" />
    <!-- Die API liefert das Blazor-Frontend im Produktionsbetrieb selbst aus (ein IIS-Site) -->
    <ProjectReference Include="..\Rausoft.Erp.Web\Rausoft.Erp.Web.csproj" />
    <!-- Manueller Odoo-Import aus der Administration (nutzt dieselben Importer wie das Konsolen-Tool) -->
    <ProjectReference Include="..\Rausoft.Erp.OdooImport\Rausoft.Erp.OdooImport.csproj" />
  </ItemGroup>

</Project>
