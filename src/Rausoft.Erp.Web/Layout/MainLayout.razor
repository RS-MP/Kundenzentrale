@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject HttpClient Http
@implements IDisposable

@if (_instanz is { Testsystem: true } test)
{
    <div class="testband" role="status">
        <strong>@test.Bezeichnung</strong>
        <span>Keine echten Vorgänge erfassen — hier wird nur ausprobiert. Es gehen keine E-Mails und keine Meldungen nach außen.</span>
    </div>
}
<div class="app-rahmen @(_instanz is { Testsystem: true } ? "mit-testband" : "")">
    <aside class="seitennav">
        <div class="marke"><span class="firma">rausoft</span> Kundenzentrale</div>
        <nav class="seitennav-links">
            <NavLink href="aufgaben">
                <svg class="ikone" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.5" y="2.5" width="11" height="11" rx="2"/><path d="M5.3 8.2l1.9 1.9 3.6-3.9"/></svg>
                Meine Aufgaben
                @if (_aufgaben is { FaelligBisHeute: > 0 } az)
                {
                    <span class="abzeichen @(az.Ueberfaellig > 0 ? "kritisch" : "")"
                          title="@(az.FaelligBisHeute) bis heute fällig@(az.Ueberfaellig > 0 ? $", davon {az.Ueberfaellig} überfällig" : "") — bei Ihnen oder im Pool Ihres Bereichs">@az.FaelligBisHeute</span>
                }
            </NavLink>
            <NavLink href="kunden">
                <svg class="ikone" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="5" r="2.6"/><path d="M2.8 13.5c.7-2.6 2.8-4 5.2-4s4.5 1.4 5.2 4"/></svg>
                Kunden
            </NavLink>
            <NavLink href="vorgaenge">
                <svg class="ikone" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 4l1.2 1.2L6 3M2.5 8.5l1.2 1.2L6 7.5"/><circle cx="4" cy="12.6" r="1.1"/><path d="M8 4.2h5.5M8 8.7h5.5M8 12.8h5.5"/></svg>
                Vorgänge
            </NavLink>
            <NavLink href="vertraege">
                <svg class="ikone" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3.2" y="2.2" width="9.6" height="11.6" rx="1.4"/><path d="M5.5 5.5h5M5.5 8h5M5.5 10.5h3"/></svg>
                Verträge
            </NavLink>
            <NavLink href="partner">
                <svg class="ikone" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="5.5" cy="5.5" r="2.2"/><circle cx="11" cy="6.5" r="1.8"/><path d="M1.8 13c.5-2.2 2-3.4 3.7-3.4S8.7 10.8 9.2 13M9.6 10.2c.4-.2.9-.3 1.4-.3 1.5 0 2.6 1 3 3.1"/></svg>
                Partner
            </NavLink>
            <NavLink href="vorlagen">
                <svg class="ikone" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4.5 2.2h5.2l3 3v8.4a1.2 1.2 0 0 1-1.2 1.2H4.5a1.2 1.2 0 0 1-1.2-1.2V3.4a1.2 1.2 0 0 1 1.2-1.2Z"/><path d="M9.5 2.4v3h3M5.8 9l1.6 1.6L10.6 7.4"/></svg>
                Vorlagen
            </NavLink>
            <NavLink href="wiki">
                <svg class="ikone" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 4.2C6.6 3 4.6 2.6 2.5 2.8v9.4c2.1-.2 4.1.2 5.5 1.4 1.4-1.2 3.4-1.6 5.5-1.4V2.8C11.4 2.6 9.4 3 8 4.2Z"/><path d="M8 4.2v9.4"/></svg>
                Wiki
                @if (_wikiHinweise is { } h && h.UnbestaetigteNeuerungen + h.OffeneMeldungen > 0)
                {
                    <span class="abzeichen" title="@WikiHinweisText(h)">@(h.UnbestaetigteNeuerungen + h.OffeneMeldungen)</span>
                }
            </NavLink>
            @if (_margenrechner)
            {
                @* Nur mit der Rolle „Margenrechner“ — die API sperrt unabhängig davon *@
                <NavLink href="margenrechner">
                    <svg class="ikone" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2.5 2.5v11h11"/><path d="M4.8 10.6l2.6-3 2.2 1.6 3.4-4.4"/></svg>
                    Margenrechner
                </NavLink>
            }
            <NavLink href="server">
                <svg class="ikone" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2.5" y="3" width="11" height="4.2" rx="1.2"/><rect x="2.5" y="8.8" width="11" height="4.2" rx="1.2"/><circle cx="5" cy="5.1" r=".9" fill="currentColor" stroke="none"/><circle cx="5" cy="10.9" r=".9" fill="currentColor" stroke="none"/></svg>
                Server
                @if (_zertHinweise is { } zh && zh.Abgelaufen + zh.Bald + zh.Pruefstoerungen + zh.Warnungen > 0)
                {
                    <span class="abzeichen @(zh.Abgelaufen > 0 ? "kritisch" : "")" title="@ZertHinweisText(zh)">@(zh.Abgelaufen + zh.Bald + zh.Pruefstoerungen + zh.Warnungen)</span>
                }
            </NavLink>
            <NavLink href="admin">
                <svg class="ikone" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="2.2"/><path d="M8 2v2M8 12v2M2 8h2M12 8h2M3.8 3.8l1.4 1.4M10.8 10.8l1.4 1.4M12.2 3.8l-1.4 1.4M5.2 10.8l-1.4 1.4"/></svg>
                Administration
            </NavLink>
        </nav>
        <div class="seitennav-fuss">
            <span class="thema-segment" role="group" aria-label="Darstellung">
                <button class="@(_thema is null ? "an" : "")" title="Automatisch (Systemeinstellung)"
                        @onclick='() => ThemaSetzenAsync(null)'>◐ Auto</button>
                <button class="@(_thema == "light" ? "an" : "")" title="Heller Modus"
                        @onclick='() => ThemaSetzenAsync("light")'>☀</button>
                <button class="@(_thema == "dark" ? "an" : "")" title="Dunkler Modus"
                        @onclick='() => ThemaSetzenAsync("dark")'>🌙</button>
            </span>
        </div>
    </aside>

    <main class="inhalt">
        @Body
    </main>
</div>

@code {
    private string? _thema; // null = Automatisch (Systemeinstellung), "light", "dark"
    private WikiHinweise? _wikiHinweise;
    private InstanzInfo? _instanz;
    private bool _margenrechner;

    protected override async Task OnInitializedAsync()
    {
        try { _instanz = await Http.GetFromJsonAsync<InstanzInfo>("api/instanz"); }
        catch { _instanz = null; /* ohne Antwort kein Band — die Sperren greifen serverseitig */ }
        try { _margenrechner = (await Http.GetFromJsonAsync<Rausoft.Erp.Dtos.Margen.MargenrechnerZugangInfo>("api/margenrechner-zugang"))?.Darf == true; }
        catch { _margenrechner = false; /* ohne Antwort kein Menüpunkt */ }
        WikiHinweisSignal.Geaendert += WikiHinweiseNachladen;
        AufgabenSignal.Geaendert += AufgabenNachladen;
        await WikiHinweiseLadenAsync();
        await AufgabenLadenAsync();
    }

    public void Dispose()
    {
        WikiHinweisSignal.Geaendert -= WikiHinweiseNachladen;
        AufgabenSignal.Geaendert -= AufgabenNachladen;
    }

    private AufgabenZaehler? _aufgaben;

    private void AufgabenNachladen() => _ = InvokeAsync(async () =>
    {
        await AufgabenLadenAsync();
        StateHasChanged();
    });

    private async Task AufgabenLadenAsync()
    {
        try { _aufgaben = await Http.GetFromJsonAsync<AufgabenZaehler>("api/aufgaben/zaehler"); }
        catch { _aufgaben = null; /* Navigation bleibt ohne Abzeichen nutzbar */ }
    }

    private void WikiHinweiseNachladen() => _ = InvokeAsync(async () =>
    {
        await WikiHinweiseLadenAsync();
        StateHasChanged();
    });

    /// <summary>Abzeichen am Wiki-Eintrag: unbestätigte Pflicht-Neuerungen + offene Meldungen der eigenen Themen. Dazu SSL-Zertifikate mit Handlungsbedarf am Server-Eintrag.</summary>
    private async Task WikiHinweiseLadenAsync()
    {
        try { _wikiHinweise = await Http.GetFromJsonAsync<WikiHinweise>("api/wiki/hinweise"); }
        catch { _wikiHinweise = null; /* Navigation bleibt ohne Abzeichen nutzbar */ }
        try { _zertHinweise = await Http.GetFromJsonAsync<ZertifikatHinweise>("api/zertifikate/hinweise"); }
        catch { _zertHinweise = null; }
    }

    private ZertifikatHinweise? _zertHinweise;

    private static string ZertHinweisText(ZertifikatHinweise z)
    {
        var teile = new List<string>();
        if (z.Abgelaufen > 0) teile.Add($"{z.Abgelaufen} SSL-Zertifikat(e) abgelaufen");
        if (z.Bald > 0) teile.Add($"{z.Bald} laufen bald ab");
        if (z.Pruefstoerungen > 0) teile.Add($"{z.Pruefstoerungen} nicht prüfbar");
        if (z.Warnungen > 0) teile.Add($"{z.Warnungen} mit Warnung");
        return string.Join(" · ", teile);
    }

    private static string WikiHinweisText(WikiHinweise h)
    {
        var teile = new List<string>();
        if (h.UnbestaetigteNeuerungen > 0)
            teile.Add($"{h.UnbestaetigteNeuerungen} {(h.UnbestaetigteNeuerungen == 1 ? "Neuerung" : "Neuerungen")} zu bestätigen");
        if (h.OffeneMeldungen > 0)
            teile.Add($"{h.OffeneMeldungen} offene {(h.OffeneMeldungen == 1 ? "Meldung" : "Meldungen")}");
        return string.Join(" · ", teile);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _thema = await JS.InvokeAsync<string?>("themaLesen");
            StateHasChanged();
        }
    }

    private async Task ThemaSetzenAsync(string? thema)
    {
        _thema = thema;
        await JS.InvokeVoidAsync("themaSetzen", _thema);
    }
}
