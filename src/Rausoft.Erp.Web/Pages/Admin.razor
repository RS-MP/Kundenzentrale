    private MitarbeiterEintrag? _mitarbBearb;
    private bool _mitarbFormOffen;
    private string _mitarbKonto = "";
    private string _mitarbName = "";
    private string _mitarbEmail = "";
    private string _mitarbBereich = "";
    private List<string> _bereiche = [];
    private bool _mitarbAktiv = true;
    private HashSet<string> _mitarbRollen = [];

    // Gruppierung: ServicePortal-Einstellungen wohnen bei den Servern, Pfade unter Verzeichnisse
    private IEnumerable<EinstellungEintrag> PortalEinstellungen() =>
        (_einstellungen ?? []).Where(e => e.Schluessel.StartsWith("ServicePortal.")
            && e.Schluessel != "ServicePortal.LetzterPush");

    private IEnumerable<EinstellungEintrag> OdooEinstellungen() =>
        (_einstellungen ?? []).Where(e => e.Schluessel.StartsWith("Odoo."));

    private IEnumerable<EinstellungEintrag> MailEinstellungen() =>
        (_einstellungen ?? []).Where(e => e.Schluessel.StartsWith("Mail.") || e.Schluessel.StartsWith("Zertifikate."));

    private IEnumerable<EinstellungEintrag> VerzeichnisEinstellungen() =>
        (_einstellungen ?? []).Where(e => !e.Schluessel.StartsWith("ServicePortal.")
            && !e.Schluessel.StartsWith("Odoo.") && !e.Schluessel.StartsWith("OdooTest.") && !e.Schluessel.StartsWith("Mail.") && !e.Schluessel.StartsWith("Zertifikate.")
            && !e.Schluessel.StartsWith("Verkauf.") && !e.Schluessel.StartsWith("Zahlungen."));

    /// <summary>Ohne die automatisch gepflegten Zeitstempel (letzter Bericht, letzter Lauf).</summary>
    private IEnumerable<EinstellungEintrag> VerkaufZahlungEinstellungen() =>
        (_einstellungen ?? []).Where(e => (e.Schluessel.StartsWith("Verkauf.") || e.Schluessel.StartsWith("Zahlungen."))
            && !e.Schluessel.Contains(".Letzter"));

    private bool _berichtLaeuft;
    private string? _berichtErgebnis;

    private async Task BerichtSendenAsync(string adresse)
    {
        _berichtLaeuft = true;
        _berichtErgebnis = null;
        try
        {
            var antwort = await Http.PostAsync(adresse, null);
            _berichtErgebnis = (await antwort.Content.ReadAsStringAsync()).Trim('"');
            if (!antwort.IsSuccessStatusCode && string.IsNullOrWhiteSpace(_berichtErgebnis))
                _berichtErgebnis = $"Fehler {(int)antwort.StatusCode}.";
        }
        catch (Exception ex)
        {
            _berichtErgebnis = $"Senden fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            _berichtLaeuft = false;
        }
    }

    private string LetzterPushText()
    {
        var wert = _werte.GetValueOrDefault("ServicePortal.LetzterPush", "");
        return wert == "" ? "noch nie gemeldet" : $"zuletzt gemeldet: {wert}";
    }

