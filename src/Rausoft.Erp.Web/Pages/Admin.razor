@page "/admin"
@implements IDisposable
@inject HttpClient Http

<PageTitle>Administration · Kundenzentrale</PageTitle>

<div class="seitenkopf">
    <h1>Administration</h1>
    <span class="untertitel">Änderungen werden protokolliert</span>
</div>

@if (_fehler is not null)
{
    <div class="fehler">@_fehler</div>
}

@* ---------- Server & Portal-Meldung ---------- *@
<details class="gruppe" open>
    <summary>Server &amp; Service-Portal-Meldung<span class="zahl">@(_server?.Count ?? 0) Server</span></summary>
    <div class="gruppe-inhalt">
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap">
            <button class="knopf" disabled="@_melde" @onclick="StatusMeldenAsync">@(_melde ? "Läuft …" : "Prüfen & ans Portal melden")</button>
            <button class="knopf sekundaer" disabled="@_melde" @onclick="StatusPruefenAsync">Nur prüfen</button>
            <span style="color:var(--muted); font-size:13px">@LetzterPushText()</span>
        </div>
        @if (_meldeBericht is not null && _meldeBericht.Unbekannt.Count > 0)
        {
            <div class="krittext" style="margin-top:6px; font-size:13px">
                Im Portal unbekannt: @string.Join(", ", _meldeBericht.Unbekannt) — Schreibweise im Portal (Menü „Server") abgleichen!
            </div>
        }

        <div style="margin-top:10px">
            @if (_server is null)
            {
                <div style="color:var(--muted)">Lade Server …</div>
            }
            else if (_server.Count == 0)
            {
                <div style="color:var(--muted)">Noch keine Server angelegt.</div>
            }
            @foreach (var server in _server ?? [])
            {
                <div class="person" style="cursor:pointer" @onclick="() => Bearbeiten(server)">
                    <div class="name">
                        <span class="status @ServerAmpel(server)">@server.Alias</span>
                        @if (!server.Aktiv)
                        {
                            <span style="color:var(--muted); font-weight:400; margin-left:6px">inaktiv</span>
                        }
                        <span style="float:right; color:var(--muted); font-weight:400; font-size:12.5px; font-variant-numeric:tabular-nums">
                            @(server.GeprueftAm is not null ? $"geprüft {server.GeprueftAm.Value.ToLocalTime():dd.MM. HH:mm}" : "noch nie geprüft")
                        </span>
                    </div>
                    <div class="details">
                        @(server.SanktionslistenStand is not null ? $"Sanktionsliste: {server.SanktionslistenStand}" : "")
                        @if (server.Fehlertext is not null)
                        {
                            <span class="krittext"> @server.Fehlertext</span>
                        }
                    </div>
                </div>
            }
            @if (!_serverFormOffen)
            {
                <button class="mehr" @onclick="NeuerServer">+ Server hinzufügen</button>
            }
        </div>

        @if (_serverFormOffen)
        {
            <div style="border-top:1px dashed var(--border); margin-top:10px; padding-top:10px">
                <div class="formular">
                    <label>Alias (exakt wie im Portal)<input type="text" @bind="_bearb.Alias" placeholder="z. B. Shared-01" /></label>
                    <label>Interne URL<input type="text" @bind="_bearb.Url" placeholder="https://…" /></label>
                    <label>Prüf-Mandant<input type="text" @bind="_bearb.PruefMandant" placeholder="customer-Kennung" /></label>
                    <label style="justify-content:center"><span><input type="checkbox" @bind="_bearb.Aktiv" /> aktiv</span></label>
                </div>
                <div class="formular-aktionen">
                    <button class="knopf" @onclick="ServerSpeichernAsync">@(_bearbId is null ? "Anlegen" : "Speichern")</button>
                    <button class="knopf sekundaer" @onclick="FormularSchliessen">Abbrechen</button>
                    @if (_bearbId is not null)
                    {
                        <span style="flex:1"></span>
                        <button class="knopf sekundaer krittext" @onclick="ServerLoeschenAsync">Löschen</button>
                    }
                </div>
            </div>
        }

        <div style="border-top:1px dashed var(--border); margin-top:12px; padding-top:10px">
            @foreach (var einstellung in PortalEinstellungen())
            {
                <div class="zeile2">
                    <span class="l" title="@einstellung.Beschreibung">@KurzName(einstellung.Schluessel)</span>
                    <span style="display:flex; gap:6px; flex:1; max-width:420px; justify-content:end">
                        <input type="text" style="flex:1; text-align:right" @bind="_werte[einstellung.Schluessel]" />
                        <button class="knopf sekundaer" @onclick="() => SpeichernAsync(einstellung.Schluessel)">
                            @(_gespeichert == einstellung.Schluessel ? "✓" : "Speichern")
                        </button>
                    </span>
                </div>
            }
            <div class="zeile2">
                <span class="l">Push-Token</span>
                <span style="display:flex; gap:6px; align-items:center">
                    @if (_tokenGesetztAm is not null)
                    {
                        <span class="status gut" style="font-size:13px">gesetzt @_tokenGesetztAm.Value.ToLocalTime().ToString("dd.MM.yyyy")</span>
                    }
                    else
                    {
                        <span class="status kritisch" style="font-size:13px">nicht gesetzt</span>
                    }
                    <button class="mehr" style="padding:0" @onclick="() => _tokenOffen = !_tokenOffen">ändern</button>
                </span>
            </div>
            @if (_tokenOffen)
            {
                <div style="display:flex; gap:8px; margin-top:4px">
                    <input type="password" style="flex:1" @bind="_tokenEingabe"
                           placeholder="Token aus Portal-Admin → Einstellungen → Server-Status (Push-API) — wird verschlüsselt gespeichert" />
                    <button class="knopf sekundaer" @onclick="TokenSpeichernAsync">Speichern</button>
                </div>
            }
        </div>
    </div>
</details>

@* ---------- Benutzer & Rollen ---------- *@
<details class="gruppe">
    <summary>Benutzer &amp; Rollen<span class="zahl">@(_mitarbeiter?.Count ?? 0)</span></summary>
    <div class="gruppe-inhalt">
        <div style="color:var(--muted); font-size:12.5px; margin-bottom:8px">
            Domänen-Benutzer werden beim ersten Aufruf automatisch angelegt (ohne Rollen).
            <b>Admin</b> schaltet diesen Bereich, Server-Verwaltung und Vertrags-Löschung frei;
            <b>Compliance</b> gibt Vertragsvorlagen frei (Admins dürfen das auch).
            <b>Vertrauliche Verträge</b> sieht vertrauliche Bestandteile (Sondervereinbarungen, Partnerverträge) vollständig — Admins nicht automatisch.
            <b>Wiki-Redaktion</b> pflegt das Wiki — nur die freigegebenen Themen (Admin und Compliance pflegen alle).
            <b>Margenrechner</b> öffnet den Margenrechner mit Einkaufspreisen und Margen und pflegt dessen Daten — nur für einzeln ausgewählte Personen, Admins nicht automatisch.
        </div>
        @if (_mitarbeiter is null)
        {
            <div style="color:var(--muted)">Lade Benutzer …</div>
        }
        @foreach (var person in _mitarbeiter ?? [])
        {
            <div class="person @(person.Aktiv ? "" : "inaktiv")" style="cursor:pointer" @onclick="() => MitarbeiterBearbeiten(person)">
                <div class="name">
                    @person.Anzeigename
                    @if (person.IstIch)
                    {
                        <span style="color:var(--muted); font-weight:400"> (ich)</span>
                    }
                    <span style="float:right; color:var(--muted); font-weight:400; font-size:12.5px">
                        @(person.Bereich is not null ? person.Bereich + " · " : "")@(person.Rollen.Count > 0 ? string.Join(" · ", person.Rollen) : "keine Rollen")@(person.Aktiv ? "" : " · deaktiviert")
                    </span>
                </div>
                <div class="details">@person.WindowsKonto @(person.Email.EndsWith("@ad.lokal") ? "" : $"· {person.Email}")</div>
            </div>
        }
        @if (!_mitarbFormOffen)
        {
            <button class="mehr" @onclick="NeuerMitarbeiter">+ Benutzer vorab anlegen</button>
        }
        @if (_mitarbFormOffen)
        {
            <div style="border-top:1px dashed var(--border); margin-top:10px; padding-top:10px">
                <div class="formular">
                    @if (_mitarbBearb is null)
                    {
                        <label>Windows-Konto<input type="text" @bind="_mitarbKonto" placeholder="RS\benutzername" /></label>
                    }
                    <label>Anzeigename<input type="text" @bind="_mitarbName" /></label>
                    @if (_mitarbBearb is not null)
                    {
                        <label>E-Mail<input type="text" @bind="_mitarbEmail" /></label>
                        <label title="Erscheint im Kundenverlauf neben dem Namen, z. B. Vertrieb, Technik, Buchhaltung">
                            Bereich<input type="text" list="bereich-vorschlaege" @bind="_mitarbBereich" placeholder="z. B. Vertrieb, Technik" />
                        </label>
                        <datalist id="bereich-vorschlaege">
                            @foreach (var b in _bereiche)
                            {
                                <option value="@b"></option>
                            }
                        </datalist>
                    }
                </div>
                @if (_mitarbBearb is not null)
                {
                    <div class="chips" style="margin-top:10px">
                        @foreach (var rolle in AlleRollen)
                        {
                            <button class="chip @(_mitarbRollen.Contains(rolle) ? "aktiv" : "")"
                                    disabled="@(_mitarbBearb.IstIch && rolle == "Admin")"
                                    @onclick="() => RolleUmschalten(rolle)">@rolle</button>
                        }
                        <label style="margin-left:12px; align-self:center; font-size:13px; color:var(--ink2)">
                            <input type="checkbox" @bind="_mitarbAktiv" disabled="@_mitarbBearb.IstIch" /> aktiv
                        </label>
                    </div>
                    @if (_mitarbRollen.Contains("Wiki-Redaktion"))
                    {
                        <div style="margin-top:8px; display:flex; gap:12px; align-items:center; flex-wrap:wrap; font-size:13px; color:var(--ink2)">
                            <span>Wiki-Themen, die diese Person pflegen darf:</span>
                            @foreach (var thema in _wikiThemen)
                            {
                                <label style="display:flex; gap:4px; align-items:center">
                                    <input type="checkbox" checked="@_mitarbWikiThemen.Contains(thema.Schluessel)"
                                           @onchange="e => WikiThemaUmschalten(thema.Schluessel, e.Value is true)" />
                                    @thema.Name
                                </label>
                            }
                            @if (_mitarbWikiThemen.Count == 0)
                            {
                                <span class="warntext" style="font-size:12.5px">ohne Thema kann die Person nichts bearbeiten</span>
                            }
                        </div>
                    }
                }
                <div class="formular-aktionen">
                    <button class="knopf" @onclick="MitarbeiterSpeichernAsync">@(_mitarbBearb is null ? "Anlegen" : "Speichern")</button>
                    <button class="knopf sekundaer" @onclick="MitarbeiterFormSchliessen">Abbrechen</button>
                    @if (_mitarbBearb is not null && !_mitarbBearb.IstIch)
                    {
                        <span style="flex:1"></span>
                        <button class="knopf sekundaer krittext" @onclick="MitarbeiterLoeschenAsync"
                                title="Nur möglich, solange der Benutzer keine Verlaufs-/Audit-Einträge hat">Löschen</button>
                    }
                </div>
            </div>
        }
    </div>
</details>

@* ---------- Bereiche & Leitung (Vorgangstypen-Pflege) ---------- *@
@if (_mitarbeiter is not null)
{
    <BereichsLeitung />
}

@* ---------- Odoo-Anbindung ---------- *@
<details class="gruppe">
    <summary>Odoo-Anbindung<span class="zahl">Import</span></summary>
    <div class="gruppe-inhalt">
        <div style="color:var(--muted); font-size:12.5px; margin-bottom:8px">
            Zugangsdaten für den Odoo-Import (nächtliche Aufgabe auf dem Server).
            Der API-Key wird verschlüsselt gespeichert und nie wieder angezeigt.
        </div>
        @foreach (var einstellung in OdooEinstellungen())
        {
            <div class="zeile2">
                <span class="l" title="@einstellung.Beschreibung">@KurzName(einstellung.Schluessel)</span>
                <span style="display:flex; gap:6px; flex:1; max-width:420px; justify-content:end">
                    <input type="text" style="flex:1; text-align:right" @bind="_werte[einstellung.Schluessel]" />
                    <button class="knopf sekundaer" @onclick="() => SpeichernAsync(einstellung.Schluessel)">
                        @(_gespeichert == einstellung.Schluessel ? "✓" : "Speichern")
                    </button>
                </span>
            </div>
        }
        <div class="zeile2">
            <span class="l">API-Key</span>
            <span style="display:flex; gap:6px; align-items:center">
                @if (_odooKeyGesetztAm is not null)
                {
                    <span class="status gut" style="font-size:13px">gesetzt @_odooKeyGesetztAm.Value.ToLocalTime().ToString("dd.MM.yyyy")</span>
                }
                else
                {
                    <span class="status kritisch" style="font-size:13px">nicht gesetzt</span>
                }
                <button class="mehr" style="padding:0" @onclick="() => _odooKeyOffen = !_odooKeyOffen">ändern</button>
            </span>
        </div>
        @if (_odooKeyOffen)
        {
            <div style="display:flex; gap:8px; margin-top:4px">
                <input type="password" style="flex:1" @bind="_odooKeyEingabe"
                       placeholder="API-Key aus Odoo (Mein Profil → Kontosicherheit → API-Schlüssel) — wird verschlüsselt gespeichert" />
                <button class="knopf sekundaer" @onclick="OdooKeySpeichernAsync">Speichern</button>
            </div>
        }
        <div style="border-top:1px dashed var(--border); margin-top:10px; padding-top:10px; display:flex; gap:10px; align-items:center; flex-wrap:wrap">
            <button class="knopf" disabled="@(_odooImport?.Laeuft == true)" @onclick="OdooImportStartenAsync">
                @(_odooImport?.Laeuft == true ? "Import läuft …" : "Import jetzt ausführen")
            </button>
            <span style="color:var(--muted); font-size:13px">@OdooImportText()</span>
        </div>
        @if (_odooImport?.Fehler is not null)
        {
            <div class="krittext" style="margin-top:6px; font-size:13px">@_odooImport.Fehler</div>
        }

        @* Chatter → Kunden-Timeline: im Testbetrieb manuell, Automatik zum Produktivstart *@
        <div style="border-top:1px dashed var(--border); margin-top:10px; padding-top:10px">
            <div style="font-weight:600; margin-bottom:2px">
                Chatter → Kunden-Timeline
                <span style="color:var(--muted); font-weight:400; font-size:12.5px; margin-left:6px">Testbetrieb: manuell</span>
            </div>
            <div style="color:var(--muted); font-size:12.5px; margin-bottom:8px">
                Den kompletten Odoo-Chatter in die Akten übernehmen. Jede Nachricht bekommt eine Stufe
                (wesentlich, Meilenstein, Systemmeldung, Feldänderung); die Akte blendet nach Kategorie ein und aus.
                <b>Analyse</b> zeigt die Chronologie eines Kunden mit Filterentscheidung,
                <b>Dry-Run</b> zählt nur, <b>Import</b> legt neue Einträge an und bewertet bereits übernommene neu.
                Anhänge werden mit Link auf das Original in Odoo verknüpft.
                Ohne Kunde gelten Dry-Run und Import für alle Kunden mit Odoo-ID.
            </div>
            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap">
                <input type="text" style="width:230px" @bind="_chatterKunde" @bind:event="oninput" disabled="@(_chatter?.Laeuft == true)"
                       placeholder="KundenNr oder Odoo-ID (leer = alle)" />
                <button class="knopf sekundaer" disabled="@(_chatter?.Laeuft == true)" @onclick='() => ChatterStartenAsync("analyse")'>Analyse</button>
                <button class="knopf sekundaer" disabled="@(_chatter?.Laeuft == true)" @onclick='() => ChatterStartenAsync("dryrun")'>Dry-Run</button>
                <button class="knopf" disabled="@(_chatter?.Laeuft == true)" @onclick='() => ChatterStartenAsync("import")'>
                    @(string.IsNullOrWhiteSpace(_chatterKunde) ? "Import (alle Kunden)" : "Import ausführen")
                </button>
                <span style="color:var(--muted); font-size:13px">@ChatterText()</span>
            </div>
            <label style="display:flex; gap:6px; align-items:center; margin-top:6px; font-size:12.5px; color:var(--muted)"
                   title="Kopiert die Anhang-Dateien zusätzlich in die Dokumentablage — vor der Odoo-Abschaltung nötig, im Testbetrieb nicht">
                <input type="checkbox" @bind="_chatterAnhaengeLaden" disabled="@(_chatter?.Laeuft == true)" />
                Anhänge zusätzlich herunterladen (Archiv vor der Odoo-Abschaltung)
            </label>
            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:10px">
                <button class="knopf sekundaer" disabled="@(_chatter?.Laeuft == true)" @onclick='() => ChatterStartenAsync("anfragen")'>Website-Anfragen auswerten</button>
                <span style="color:var(--muted); font-size:12.5px">
                    Zählt, wie viele Verkaufschancen in Odoo ein Formular und Herkunftsfelder tragen (nur lesen) —
                    Grundlage für die Übernahme alter Anfragen.
                </span>
            </div>
            <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:10px">
                <button class="knopf sekundaer" disabled="@(_chatter?.Laeuft == true)" @onclick='() => ChatterStartenAsync("anfragen-probe")'>Anfragen übernehmen: Probelauf</button>
                <button class="knopf" disabled="@(_chatter?.Laeuft == true)" @onclick='() => ChatterStartenAsync("anfragen-import")'>Anfragen übernehmen</button>
                <span style="color:var(--muted); font-size:12.5px">
                    Legt die als Website-Anfrage erkennbaren Verkaufschancen unter „Anfragen“ an, mit Herkunft und Ausgang laut Odoo.
                    Odoo wird nur gelesen; ein erneuter Lauf legt nichts doppelt an und zieht nur den Ausgang nach.
                    Eigene Tests über den Google Tag Assistant und hier gelöschte Anfragen bleiben außen vor.
                </span>
            </div>
            @if (_chatter?.Fehler is not null)
            {
                <div class="krittext" style="margin-top:6px; font-size:13px">@_chatter.Fehler</div>
            }
            @if (!string.IsNullOrEmpty(_chatter?.Bericht))
            {
                <pre class="bericht">@_chatter.Bericht</pre>
            }
        </div>
    </div>
</details>

@* ---------- Odoo-Testdatenbank und Schreibziel ---------- *@
<OdooTestdatenbank />

@* ---------- E-Mail-Versand (SMTP) & Zertifikats-Erinnerungen ---------- *@
<details class="gruppe">
    <summary>E-Mail-Versand und Zertifikats-Erinnerungen<span class="zahl">SMTP</span></summary>
    <div class="gruppe-inhalt">
        <div style="color:var(--muted); font-size:12.5px; margin-bottom:8px">
            SMTP-Zugang für Benachrichtigungen der Kundenzentrale — zuerst für die Erinnerungen an ablaufende
            <a href="zertifikate">SSL-Zertifikate</a>. Das Passwort wird verschlüsselt gespeichert und nie wieder angezeigt.
        </div>
        @foreach (var einstellung in MailEinstellungen())
        {
            <div class="zeile2">
                <span class="l" title="@einstellung.Beschreibung">@KurzName(einstellung.Schluessel)</span>
                <span style="display:flex; gap:6px; flex:1; max-width:420px; justify-content:end">
                    <input type="text" style="flex:1; text-align:right" @bind="_werte[einstellung.Schluessel]" />
                    <button class="knopf sekundaer" @onclick="() => SpeichernAsync(einstellung.Schluessel)">
                        @(_gespeichert == einstellung.Schluessel ? "✓" : "Speichern")
                    </button>
                </span>
            </div>
        }
        <div class="zeile2">
            <span class="l">SMTP-Passwort</span>
            <span style="display:flex; gap:6px; align-items:center">
                @if (_mailPasswortGesetztAm is not null)
                {
                    <span class="status gut" style="font-size:13px">gesetzt @_mailPasswortGesetztAm.Value.ToLocalTime().ToString("dd.MM.yyyy")</span>
                }
                else
                {
                    <span class="status kritisch" style="font-size:13px">nicht gesetzt</span>
                }
                <button class="mehr" style="padding:0" @onclick="() => _mailPasswortOffen = !_mailPasswortOffen">ändern</button>
            </span>
        </div>
        @if (_mailPasswortOffen)
        {
            <div style="display:flex; gap:8px; margin-top:4px">
                <input type="password" style="flex:1" @bind="_mailPasswortEingabe" placeholder="Passwort des SMTP-Benutzers — wird verschlüsselt gespeichert" />
                <button class="knopf sekundaer" @onclick="MailPasswortSpeichernAsync">Speichern</button>
            </div>
        }
        <div style="border-top:1px dashed var(--border); margin-top:10px; padding-top:10px; display:flex; gap:8px; align-items:center; flex-wrap:wrap">
            <input type="text" style="min-width:260px" @bind="_testmailEmpfaenger" placeholder="Testmail an … (E-Mail-Adresse)" />
            <button class="knopf sekundaer" disabled="@_testmailLaeuft" @onclick="TestmailAsync">@(_testmailLaeuft ? "Sende …" : "Testmail senden")</button>
            @if (_testmailErgebnis is not null)
            {
                <span style="font-size:13px" class="@(_testmailErgebnis.StartsWith("Versand fehl") ? "krittext" : "")">@_testmailErgebnis</span>
            }
        </div>
    </div>
</details>

@* ---------- Offene Angebote und Kontoauszüge ---------- *@
<details class="gruppe">
    <summary>Offene Angebote und Kontoauszüge<span class="zahl">@VerkaufZahlungEinstellungen().Count()</span></summary>
    <div class="gruppe-inhalt">
        <div style="color:var(--muted); font-size:12.5px; margin-bottom:8px">
            Nachfass-Aufgaben und Wochenübersicht zu den <a href="angebote">offenen Angeboten und Aufträgen</a> sowie Eingangsordner,
            Buchen und Meldungen der <a href="zahlungen">Zahlungen</a>. In Odoo gebucht wird nur, wenn unter „Odoo-Testdatenbank“ das
            Schreibziel auf Test oder Produktiv steht.
        </div>
        @foreach (var einstellung in VerkaufZahlungEinstellungen())
        {
            <div style="padding:8px 0; border-bottom:1px dashed var(--border)">
                <div style="font-weight:600; font-size:13px">@KurzName(einstellung.Schluessel)</div>
                <div style="color:var(--muted); font-size:12.5px; margin:2px 0 6px">@einstellung.Beschreibung</div>
                <div style="display:flex; gap:8px">
                    <input type="text" style="flex:1" @bind="_werte[einstellung.Schluessel]" />
                    <button class="knopf sekundaer" @onclick="() => SpeichernAsync(einstellung.Schluessel)">
                        @(_gespeichert == einstellung.Schluessel ? "✓ gespeichert" : "Speichern")
                    </button>
                </div>
            </div>
        }
        <div style="margin-top:10px; display:flex; gap:10px; align-items:center; flex-wrap:wrap">
            <button class="knopf sekundaer" disabled="@_berichtLaeuft" @onclick='() => BerichtSendenAsync("api/verkauf/bericht")'
                    title="Sendet die Wochenübersicht der offenen Angebote und Aufträge sofort an die eingetragenen Empfänger.">Übersicht Angebote jetzt senden</button>
            <button class="knopf sekundaer" disabled="@_berichtLaeuft" @onclick='() => BerichtSendenAsync("api/zahlungen/bericht")'
                    title="Sendet die Übersicht der ausstehenden Zahlungen sofort an die eingetragenen Empfänger.">Übersicht Zahlungen jetzt senden</button>
            <span style="color:var(--muted); font-size:13px">@_berichtErgebnis</span>
        </div>
    </div>
</details>

@* ---------- Verzeichnisse ---------- *@
<details class="gruppe">
    <summary>Verzeichnisse<span class="zahl">@VerzeichnisEinstellungen().Count()</span></summary>
    <div class="gruppe-inhalt">
        @if (_einstellungen is null)
        {
            <div style="color:var(--muted)">Lade Einstellungen …</div>
        }
        @foreach (var einstellung in VerzeichnisEinstellungen())
        {
            <div style="padding:8px 0; border-bottom:1px dashed var(--border)">
                <div style="font-weight:600; font-size:13px">@KurzName(einstellung.Schluessel)</div>
                <div style="color:var(--muted); font-size:12.5px; margin:2px 0 6px">@einstellung.Beschreibung</div>
                <div style="display:flex; gap:8px">
                    <input type="text" style="flex:1; font-family:Consolas,monospace; font-size:13px"
                           @bind="_werte[einstellung.Schluessel]" placeholder="z. B. \\server\freigabe\ordner" />
                    <button class="knopf sekundaer" @onclick="() => SpeichernAsync(einstellung.Schluessel)">
                        @(_gespeichert == einstellung.Schluessel ? "✓ gespeichert" : "Speichern")
                    </button>
                </div>
            </div>
        }
        <div class="zeile2" style="margin-top:8px">
            <span class="l" title="Passwort des Signatur-Zertifikats (PFX) — wird verschlüsselt gespeichert, nie angezeigt">Signatur-PFX-Passwort</span>
            <span style="display:flex; gap:6px; align-items:center">
                @if (_pfxGesetztAm is not null)
                {
                    <span class="status gut" style="font-size:13px">gesetzt @_pfxGesetztAm.Value.ToLocalTime().ToString("dd.MM.yyyy")</span>
                }
                else
                {
                    <span class="status" style="font-size:13px">nicht gesetzt</span>
                }
                <button class="mehr" style="padding:0" @onclick="() => _pfxOffen = !_pfxOffen">ändern</button>
            </span>
        </div>
        @if (_pfxOffen)
        {
            <div style="display:flex; gap:8px; margin-top:4px">
                <input type="password" style="flex:1" @bind="_pfxEingabe" placeholder="Passwort der PFX-Datei — wird verschlüsselt gespeichert" />
                <button class="knopf sekundaer" @onclick="PfxSpeichernAsync">Speichern</button>
            </div>
        }
        <div style="border-top:1px dashed var(--border); margin-top:10px; padding-top:10px; display:flex; gap:10px; align-items:center; flex-wrap:wrap">
            <button class="knopf sekundaer" disabled="@_datenNachtragen" @onclick="DokumentdatenNachtragenAsync"
                    title="Ermittelt für Vertragsbestandteile ohne Datum den Stand aus Dateiname bzw. Datei-Änderungsdatum (Reihenfolge der Dokumente). Gepflegte Daten bleiben unverändert.">
                @(_datenNachtragen ? "Läuft …" : "Dokumentdaten nachtragen")
            </button>
            <span style="color:var(--muted); font-size:13px">@_datenErgebnis</span>
        </div>
    </div>
</details>

@code {
    private bool _datenNachtragen;
    private string? _datenErgebnis;

    private async Task DokumentdatenNachtragenAsync()
    {
        _datenNachtragen = true;
        _datenErgebnis = null;
        try
        {
            var antwort = await Http.PostAsync("api/vertraege/dokumentdaten-nachtragen", null);
            if (!antwort.IsSuccessStatusCode)
            {
                _datenErgebnis = await antwort.Content.ReadAsStringAsync();
                return;
            }
            var e = await antwort.Content.ReadFromJsonAsync<DokumentdatenNachgetragen>();
            _datenErgebnis = e!.Geprueft == 0
                ? "✓ Alle Bestandteile haben bereits ein Dokumentdatum."
                : $"✓ {e.Geprueft} Bestandteile: {e.AusDateiname} aus Dateiname, {e.AusDateidatum} aus Dateidatum, {e.OhneDatei} ohne erreichbare Datei.";
        }
        catch (Exception ex)
        {
            _datenErgebnis = $"Fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            _datenNachtragen = false;
        }
    }

