    private string _testmailEmpfaenger = "";
    private bool _testmailLaeuft;
    private string? _testmailErgebnis;
    private OdooImportStatus? _odooImport;
    private readonly CancellationTokenSource _seiteVerlassen = new();

    private static readonly string[] AlleRollen = ["Admin", "Compliance", "Vertrauliche Verträge", "Wiki-Redaktion", "Margenrechner", "Vertrieb", "Support", "Buchhaltung"];
    private List<WikiThemaEintrag> _wikiThemen = [];
    private HashSet<string> _mitarbWikiThemen = [];
