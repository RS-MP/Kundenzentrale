@page "/admin"
@implements IDisposable
@inject HttpClient Http

<PageTitle>Administration · Kundenzentrale</PageTitle>

<div class="seitenkopf">
    <h1>Administration</h1>
    <span class="untertitel">Änderungen werden protokolliert</span>
</div>

@if (_fehler is not null)
{
    <div class="fehler">@_fehler</div>
}

@* ---------- Server & Portal-Meldung ---------- *@
<details class="gruppe" open>
    <summary>Server &amp; Service-Portal-Meldung<span class="zahl">@(_server?.Count ?? 0) Server</span></summary>
    <div class="gruppe-inhalt">
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap">
            <button class="knopf" disabled="@_melde" @onclick="StatusMeldenAsync">@(_melde ? "Läuft …" : "Prüfen & ans Portal melden")</button>
            <button class="knopf sekundaer" disabled="@_melde" @onclick="StatusPruefenAsync">Nur prüfen</button>
            <span style="color:var(--muted); font-size:13px">@LetzterPushText()</span>
        </div>
        @if (_meldeBericht is not null && _meldeBericht.Unbekannt.Count > 0)
        {
            <div class="krittext" style="margin-top:6px; font-size:13px">
                Im Portal unbekannt: @string.Join(", ", _meldeBericht.Unbekannt) — Schreibweise im Portal (Menü „Server") abgleichen!
            </div>
        }

        <div style="margin-top:10px">
            @if (_server is null)
            {
                <div style="color:var(--muted)">Lade Server …</div>
            }
            else if (_server.Count == 0)
            {
                <div style="color:var(--muted)">Noch keine Server angelegt.</div>
            }
            @foreach (var server in _server ?? [])
            {
                <div class="person" style="cursor:pointer" @onclick="() => Bearbeiten(server)">
                    <div class="name">
                        <span class="status @ServerAmpel(server)">@server.Alias</span>
                        @if (!server.Aktiv)
                        {
                            <span style="color:var(--muted); font-weight:400; margin-left:6px">inaktiv</span>
                        }
                        <span style="float:right; color:var(--muted); font-weight:400; font-size:12.5px; font-variant-numeric:tabular-nums">
                            @(server.GeprueftAm is not null ? $"geprüft {server.GeprueftAm.Value.ToLocalTime():dd.MM. HH:mm}" : "noch nie geprüft")
                        </span>
                    </div>
                    <div class="details">
                        @(server.SanktionslistenStand is not null ? $"Sanktionsliste: {server.SanktionslistenStand}" : "")
                        @if (server.Fehlertext is not null)
                        {
                            <span class="krittext"> @server.Fehlertext</span>
                        }
                    </div>
                </div>
            }
            @if (!_serverFormOffen)
            {
                <button class="mehr" @onclick="NeuerServer">+ Server hinzufügen</button>
            }
        </div>

        @if (_serverFormOffen)
        {
            <div style="border-top:1px dashed var(--border); margin-top:10px; padding-top:10px">
                <div class="formular">
                    <label>Alias (exakt wie im Portal)<input type="text" @bind="_bearb.Alias" placeholder="z. B. Shared-01" /></label>
                    <label>Interne URL<input type="text" @bind="_bearb.Url" placeholder="https://…" /></label>
                    <label>Prüf-Mandant<input type="text" @bind="_bearb.PruefMandant" placeholder="customer-Kennung" /></label>
                    <label style="justify-content:center"><span><input type="checkbox" @bind="_bearb.Aktiv" /> aktiv</span></label>
                </div>
                <div class="formular-aktionen">
                    <button class="knopf" @onclick="ServerSpeichernAsync">@(_bearbId is null ? "Anlegen" : "Speichern")</button>
                    <button class="knopf sekundaer" @onclick="FormularSchliessen">Abbrechen</button>
                    @if (_bearbId is not null)
                    {
                        <span style="flex:1"></span>
                        <button class="knopf sekundaer krittext" @onclick="ServerLoeschenAsync">Löschen</button>
                    }
                </div>
            </div>
        }

        <div style="border-top:1px dashed var(--border); margin-top:12px; padding-top:10px">
            @foreach (var einstellung in PortalEinstellungen())
            {
                <div class="zeile2">
                    <span class="l" title="@einstellung.Beschreibung">@KurzName(einstellung.Schluessel)</span>
                    <span style="display:flex; gap:6px; flex:1; max-width:420px; justify-content:end">
                        <input type="text" style="flex:1; text-align:right" @bind="_werte[einstellung.Schluessel]" />
                        <button class="knopf sekundaer" @onclick="() => SpeichernAsync(einstellung.Schluessel)">
                            @(_gespeichert == einstellung.Schluessel ? "✓" : "Speichern")
                        </button>
                    </span>
                </div>
            }
            <div class="zeile2">
                <span class="l">Push-Token</span>
                <span style="display:flex; gap:6px; align-items:center">
                    @if (_tokenGesetztAm is not null)
                    {
                        <span class="status gut" style="font-size:13px">gesetzt @_tokenGesetztAm.Value.ToLocalTime().ToString("dd.MM.yyyy")</span>
                    }
                    else
                    {
                        <span class="status kritisch" style="font-size:13px">nicht gesetzt</span>
                    }
                    <button class="mehr" style="padding:0" @onclick="() => _tokenOffen = !_tokenOffen">ändern</button>
                </span>
            </div>
            @if (_tokenOffen)
            {
                <div style="display:flex; gap:8px; margin-top:4px">
                    <input type="password" style="flex:1" @bind="_tokenEingabe"
                           placeholder="Token aus Portal-Admin → Einstellungen → Server-Status (Push-API) — wird verschlüsselt gespeichert" />
                    <button class="knopf sekundaer" @onclick="TokenSpeichernAsync">Speichern</button>
                </div>
            }
        </div>
    </div>
</details>

@* ---------- Benutzer & Rollen ---------- *@
<details class="gruppe">
    <summary>Benutzer &amp; Rollen<span class="zahl">@(_mitarbeiter?.Count ?? 0)</span></summary>
    <div class="gruppe-inhalt">
        <div style="color:var(--muted); font-size:12.5px; margin-bottom:8px">
            Domänen-Benutzer werden beim ersten Aufruf automatisch angelegt (ohne Rollen).
            <b>Admin</b> schaltet diesen Bereich, Server-Verwaltung und Vertrags-Löschung frei;
            <b>Compliance</b> gibt Vertragsvorlagen frei (Admins dürfen das auch).
        </div>
        @if (_mitarbeiter is null)
        {
            <div style="color:var(--muted)">Lade Benutzer …</div>
        }
        @foreach (var person in _mitarbeiter ?? [])
        {
            <div class="person @(person.Aktiv ? "" : "inaktiv")" style="cursor:pointer" @onclick="() => MitarbeiterBearbeiten(person)">
                <div class="name">
                    @person.Anzeigename
                    @if (person.IstIch)
                    {
                        <span style="color:var(--muted); font-weight:400"> (ich)</span>
                    }
                    <span style="float:right; color:var(--muted); font-weight:400; font-size:12.5px">
                        @(person.Rollen.Count > 0 ? string.Join(" · ", person.Rollen) : "keine Rollen")@(person.Aktiv ? "" : " · deaktiviert")
                    </span>
                </div>
                <div class="details">@person.WindowsKonto @(person.Email.EndsWith("@ad.lokal") ? "" : $"· {person.Email}")</div>
            </div>
        }
        @if (!_mitarbFormOffen)
        {
            <button class="mehr" @onclick="NeuerMitarbeiter">+ Benutzer vorab anlegen</button>
        }
        @if (_mitarbFormOffen)
        {
            <div style="border-top:1px dashed var(--border); margin-top:10px; padding-top:10px">
                <div class="formular">
                    @if (_mitarbBearb is null)
                    {
                        <label>Windows-Konto<input type="text" @bind="_mitarbKonto" placeholder="RS\benutzername" /></label>
                    }
                    <label>Anzeigename<input type="text" @bind="_mitarbName" /></label>
                    @if (_mitarbBearb is not null)
                    {
                        <label>E-Mail<input type="text" @bind="_mitarbEmail" /></label>
                    }
                </div>
                @if (_mitarbBearb is not null)
                {
                    <div class="chips" style="margin-top:10px">
                        @foreach (var rolle in AlleRollen)
                        {
                            <button class="chip @(_mitarbRollen.Contains(rolle) ? "aktiv" : "")"
                                    disabled="@(_mitarbBearb.IstIch && rolle == "Admin")"
                                    @onclick="() => RolleUmschalten(rolle)">@rolle</button>
                        }
                        <label style="margin-left:12px; align-self:center; font-size:13px; color:var(--ink2)">
                            <input type="checkbox" @bind="_mitarbAktiv" disabled="@_mitarbBearb.IstIch" /> aktiv
                        </label>
                    </div>
                }
                <div class="formular-aktionen">
                    <button class="knopf" @onclick="MitarbeiterSpeichernAsync">@(_mitarbBearb is null ? "Anlegen" : "Speichern")</button>
                    <button class="knopf sekundaer" @onclick="MitarbeiterFormSchliessen">Abbrechen</button>
                    @if (_mitarbBearb is not null && !_mitarbBearb.IstIch)
                    {
                        <span style="flex:1"></span>
                        <button class="knopf sekundaer krittext" @onclick="MitarbeiterLoeschenAsync"
                                title="Nur möglich, solange der Benutzer keine Verlaufs-/Audit-Einträge hat">Löschen</button>
                    }
                </div>
            </div>
        }
    </div>
</details>

@* ---------- Odoo-Anbindung ---------- *@
<details class="gruppe">
    <summary>Odoo-Anbindung<span class="zahl">Import</span></summary>
    <div class="gruppe-inhalt">
        <div style="color:var(--muted); font-size:12.5px; margin-bottom:8px">
            Zugangsdaten für den Odoo-Import (nächtliche Aufgabe auf dem Server).
            Der API-Key wird verschlüsselt gespeichert und nie wieder angezeigt.
        </div>
        @foreach (var einstellung in OdooEinstellungen())
        {
            <div class="zeile2">
                <span class="l" title="@einstellung.Beschreibung">@KurzName(einstellung.Schluessel)</span>
                <span style="display:flex; gap:6px; flex:1; max-width:420px; justify-content:end">
                    <input type="text" style="flex:1; text-align:right" @bind="_werte[einstellung.Schluessel]" />
                    <button class="knopf sekundaer" @onclick="() => SpeichernAsync(einstellung.Schluessel)">
                        @(_gespeichert == einstellung.Schluessel ? "✓" : "Speichern")
                    </button>
                </span>
            </div>
        }
        <div class="zeile2">
            <span class="l">API-Key</span>
            <span style="display:flex; gap:6px; align-items:center">
                @if (_odooKeyGesetztAm is not null)
                {
                    <span class="status gut" style="font-size:13px">gesetzt @_odooKeyGesetztAm.Value.ToLocalTime().ToString("dd.MM.yyyy")</span>
                }
                else
                {
                    <span class="status kritisch" style="font-size:13px">nicht gesetzt</span>
                }
                <button class="mehr" style="padding:0" @onclick="() => _odooKeyOffen = !_odooKeyOffen">ändern</button>
            </span>
        </div>
        @if (_odooKeyOffen)
        {
            <div style="display:flex; gap:8px; margin-top:4px">
                <input type="password" style="flex:1" @bind="_odooKeyEingabe"
                       placeholder="API-Key aus Odoo (Mein Profil → Kontosicherheit → API-Schlüssel) — wird verschlüsselt gespeichert" />
                <button class="knopf sekundaer" @onclick="OdooKeySpeichernAsync">Speichern</button>
            </div>
        }
        <div style="border-top:1px dashed var(--border); margin-top:10px; padding-top:10px; display:flex; gap:10px; align-items:center; flex-wrap:wrap">
            <button class="knopf" disabled="@(_odooImport?.Laeuft == true)" @onclick="OdooImportStartenAsync">
                @(_odooImport?.Laeuft == true ? "Import läuft …" : "Import jetzt ausführen")
            </button>
            <span style="color:var(--muted); font-size:13px">@OdooImportText()</span>
        </div>
        @if (_odooImport?.Fehler is not null)
        {
            <div class="krittext" style="margin-top:6px; font-size:13px">@_odooImport.Fehler</div>
        }
    </div>
</details>

@* ---------- Verzeichnisse ---------- *@
<details class="gruppe">
    <summary>Verzeichnisse<span class="zahl">@VerzeichnisEinstellungen().Count()</span></summary>
    <div class="gruppe-inhalt">
        @if (_einstellungen is null)
        {
            <div style="color:var(--muted)">Lade Einstellungen …</div>
        }
        @foreach (var einstellung in VerzeichnisEinstellungen())
        {
            <div style="padding:8px 0; border-bottom:1px dashed var(--border)">
                <div style="font-weight:600; font-size:13px">@KurzName(einstellung.Schluessel)</div>
                <div style="color:var(--muted); font-size:12.5px; margin:2px 0 6px">@einstellung.Beschreibung</div>
                <div style="display:flex; gap:8px">
                    <input type="text" style="flex:1; font-family:Consolas,monospace; font-size:13px"
                           @bind="_werte[einstellung.Schluessel]" placeholder="z. B. \\server\freigabe\ordner" />
                    <button class="knopf sekundaer" @onclick="() => SpeichernAsync(einstellung.Schluessel)">
                        @(_gespeichert == einstellung.Schluessel ? "✓ gespeichert" : "Speichern")
                    </button>
                </div>
            </div>
        }
    </div>
</details>

@code {
    private List<EinstellungEintrag>? _einstellungen;
    private readonly Dictionary<string, string> _werte = [];
    private string? _gespeichert;
    private string? _fehler;

    private List<ServerEintrag>? _server;
    private int? _bearbId;
    private ServerFormular _bearb = new();
    private bool _serverFormOffen;
    private bool _melde;
    private MeldeBericht? _meldeBericht;
    private bool _tokenOffen;
    private string _tokenEingabe = "";
    private DateTime? _tokenGesetztAm;
    private bool _odooKeyOffen;
    private string _odooKeyEingabe = "";
    private DateTime? _odooKeyGesetztAm;
    private OdooImportStatus? _odooImport;
    private readonly CancellationTokenSource _seiteVerlassen = new();

    private static readonly string[] AlleRollen = ["Admin", "Compliance", "Vertrieb", "Support", "Buchhaltung"];
    private List<MitarbeiterEintrag>? _mitarbeiter;
    private MitarbeiterEintrag? _mitarbBearb;
    private bool _mitarbFormOffen;
    private string _mitarbKonto = "";
    private string _mitarbName = "";
    private string _mitarbEmail = "";
    private bool _mitarbAktiv = true;
    private HashSet<string> _mitarbRollen = [];

    // Gruppierung: ServicePortal-Einstellungen wohnen bei den Servern, Pfade unter Verzeichnisse
    private IEnumerable<EinstellungEintrag> PortalEinstellungen() =>
        (_einstellungen ?? []).Where(e => e.Schluessel.StartsWith("ServicePortal.")
            && e.Schluessel != "ServicePortal.LetzterPush");

    private IEnumerable<EinstellungEintrag> OdooEinstellungen() =>
        (_einstellungen ?? []).Where(e => e.Schluessel.StartsWith("Odoo."));

    private IEnumerable<EinstellungEintrag> VerzeichnisEinstellungen() =>
        (_einstellungen ?? []).Where(e => !e.Schluessel.StartsWith("ServicePortal.")
            && !e.Schluessel.StartsWith("Odoo."));

    private string LetzterPushText()
    {
        var wert = _werte.GetValueOrDefault("ServicePortal.LetzterPush", "");
        return wert == "" ? "noch nie gemeldet" : $"zuletzt gemeldet: {wert}";
    }

    private static string KurzName(string schluessel) => schluessel switch
    {
        "ServicePortal.Url" => "Portal-URL",
        "ServicePortal.IntervallMinuten" => "Automatik-Intervall (Minuten, 0 = aus)",
        "Odoo.Url" => "Odoo-URL",
        "Odoo.Datenbank" => "Datenbank",
        "Odoo.Benutzer" => "API-Benutzer (Login)",
        "Vertragsablage.Verzeichnis" => "Vertragsablage",
        "Dokumentablage.Verzeichnis" => "Dokumentablage",
        "Vorlagen.Verzeichnis" => "Word-Vorlagen",
        "Vertragserzeugung.Zielverzeichnis" => "Ziel für erzeugte Verträge",
        _ => schluessel,
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _einstellungen = await Http.GetFromJsonAsync<List<EinstellungEintrag>>("api/einstellungen");
            foreach (var einstellung in _einstellungen ?? [])
                _werte[einstellung.Schluessel] = einstellung.Wert;
            await ServerLadenAsync();
            _mitarbeiter = await Http.GetFromJsonAsync<List<MitarbeiterEintrag>>("api/mitarbeiter") ?? [];
            var geheimnisse = await Http.GetFromJsonAsync<List<GeheimnisStatus>>("api/server/geheimnisse") ?? [];
            _tokenGesetztAm = geheimnisse.FirstOrDefault(g => g.Schluessel == "ServicePortal.PushToken")?.GesetztAm;
            _odooKeyGesetztAm = geheimnisse.FirstOrDefault(g => g.Schluessel == "Odoo.ApiKey")?.GesetztAm;
            _odooImport = await Http.GetFromJsonAsync<OdooImportStatus>("api/odoo-import");
            if (_odooImport?.Laeuft == true)
                _ = OdooImportVerfolgenAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _fehler = "Kein Zugriff: Der Admin-Bereich erfordert die Administrator-Rolle.";
        }
        catch (Exception ex)
        {
            _fehler = $"Einstellungen konnten nicht geladen werden: {ex.Message}";
        }
    }

    private async Task ServerLadenAsync() =>
        _server = await Http.GetFromJsonAsync<List<ServerEintrag>>("api/server") ?? [];

    private static string ServerAmpel(ServerEintrag s) =>
        s.IstErreichbar is null ? ""
        : s.IstErreichbar == false ? "kritisch"
        : s.ConnectorAktiv == false ? "warnung"
        : "gut";

    private void Bearbeiten(ServerEintrag server)
    {
        _bearbId = server.Id;
        _serverFormOffen = true;
        _bearb = new ServerFormular
        {
            Alias = server.Alias, Url = server.Url,
            PruefMandant = server.PruefMandant, Aktiv = server.Aktiv,
        };
    }

    private void NeuerServer()
    {
        _bearbId = null;
        _serverFormOffen = true;
        _bearb = new ServerFormular();
    }

    private void FormularSchliessen()
    {
        _serverFormOffen = false;
        _bearbId = null;
    }

    private async Task ServerSpeichernAsync()
    {
        _fehler = null;
        try
        {
            var daten = new ServerAendern(_bearb.Alias, _bearb.Url, _bearb.PruefMandant, _bearb.Aktiv);
            var antwort = _bearbId is null
                ? await Http.PostAsJsonAsync("api/server", daten)
                : await Http.PutAsJsonAsync($"api/server/{_bearbId}", daten);
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            FormularSchliessen();
            await ServerLadenAsync();
        }
        catch (Exception ex)
        {
            _fehler = $"Server konnte nicht gespeichert werden: {ex.Message}";
        }
    }

    private async Task ServerLoeschenAsync()
    {
        if (_bearbId is null)
            return;
        _fehler = null;
        var antwort = await Http.DeleteAsync($"api/server/{_bearbId}");
        if (!antwort.IsSuccessStatusCode)
        {
            _fehler = await antwort.Content.ReadAsStringAsync();
            return;
        }
        FormularSchliessen();
        await ServerLadenAsync();
    }

    private async Task StatusPruefenAsync()
    {
        _fehler = null;
        _melde = true;
        try
        {
            _server = await (await Http.PostAsync("api/server/status-pruefen", null))
                .Content.ReadFromJsonAsync<List<ServerEintrag>>();
        }
        catch (Exception ex)
        {
            _fehler = $"Prüfen fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            _melde = false;
        }
    }

    private async Task StatusMeldenAsync()
    {
        _fehler = null;
        _melde = true;
        _meldeBericht = null;
        try
        {
            var antwort = await Http.PostAsync("api/server/status-melden", null);
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            _meldeBericht = await antwort.Content.ReadFromJsonAsync<MeldeBericht>();
            _server = _meldeBericht?.Server;
            var einstellungen = await Http.GetFromJsonAsync<List<EinstellungEintrag>>("api/einstellungen") ?? [];
            var letzter = einstellungen.FirstOrDefault(e => e.Schluessel == "ServicePortal.LetzterPush");
            if (letzter is not null)
                _werte[letzter.Schluessel] = letzter.Wert;
        }
        catch (Exception ex)
        {
            _fehler = $"Meldung fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            _melde = false;
        }
    }

    private async Task TokenSpeichernAsync()
    {
        if (string.IsNullOrWhiteSpace(_tokenEingabe))
            return;
        _fehler = null;
        var antwort = await Http.PutAsJsonAsync("api/server/geheimnisse/ServicePortal.PushToken",
            new GeheimnisSetzen(_tokenEingabe.Trim()));
        if (!antwort.IsSuccessStatusCode)
        {
            _fehler = await antwort.Content.ReadAsStringAsync();
            return;
        }
        _tokenEingabe = "";
        _tokenOffen = false;
        _tokenGesetztAm = DateTime.UtcNow;
    }

    private string OdooImportText() =>
        _odooImport?.Laeuft == true
            ? $"läuft seit {_odooImport.GestartetAm?.ToLocalTime():HH:mm} Uhr — importiert Kontakte und Abos, das dauert einige Minuten"
            : _odooImport?.LetzterLauf is { Length: > 0 } letzter ? $"Zuletzt: {letzter}" : "Noch nie gelaufen";

    private async Task OdooImportStartenAsync()
    {
        _fehler = null;
        var antwort = await Http.PostAsync("api/odoo-import/start", null);
        if (!antwort.IsSuccessStatusCode)
        {
            _fehler = await antwort.Content.ReadAsStringAsync();
            return;
        }
        _odooImport = await antwort.Content.ReadFromJsonAsync<OdooImportStatus>();
        _ = OdooImportVerfolgenAsync();
    }

    private async Task OdooImportVerfolgenAsync()
    {
        try
        {
            while (_odooImport?.Laeuft == true && !_seiteVerlassen.IsCancellationRequested)
            {
                await Task.Delay(3000, _seiteVerlassen.Token);
                _odooImport = await Http.GetFromJsonAsync<OdooImportStatus>("api/odoo-import", _seiteVerlassen.Token);
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Seite verlassen — Import läuft serverseitig weiter
        }
    }

    public void Dispose() => _seiteVerlassen.Cancel();

    private async Task OdooKeySpeichernAsync()
    {
        if (string.IsNullOrWhiteSpace(_odooKeyEingabe))
            return;
        _fehler = null;
        var antwort = await Http.PutAsJsonAsync("api/server/geheimnisse/Odoo.ApiKey",
            new GeheimnisSetzen(_odooKeyEingabe.Trim()));
        if (!antwort.IsSuccessStatusCode)
        {
            _fehler = await antwort.Content.ReadAsStringAsync();
            return;
        }
        _odooKeyEingabe = "";
        _odooKeyOffen = false;
        _odooKeyGesetztAm = DateTime.UtcNow;
    }

    private async Task SpeichernAsync(string schluessel)
    {
        _fehler = null;
        _gespeichert = null;
        try
        {
            var antwort = await Http.PutAsJsonAsync(
                $"api/einstellungen/{Uri.EscapeDataString(schluessel)}",
                new EinstellungAenderung(_werte.GetValueOrDefault(schluessel, "")));
            antwort.EnsureSuccessStatusCode();
            _gespeichert = schluessel;
        }
        catch (Exception ex)
        {
            _fehler = $"Speichern fehlgeschlagen: {ex.Message}";
        }
    }

    // ---------- Benutzer & Rollen ----------

    private void MitarbeiterBearbeiten(MitarbeiterEintrag person)
    {
        _mitarbBearb = person;
        _mitarbFormOffen = true;
        _mitarbName = person.Anzeigename;
        _mitarbEmail = person.Email;
        _mitarbAktiv = person.Aktiv;
        _mitarbRollen = person.Rollen.ToHashSet(StringComparer.OrdinalIgnoreCase);
    }

    private void NeuerMitarbeiter()
    {
        _mitarbBearb = null;
        _mitarbFormOffen = true;
        _mitarbKonto = "";
        _mitarbName = "";
    }

    private void MitarbeiterFormSchliessen()
    {
        _mitarbFormOffen = false;
        _mitarbBearb = null;
    }

    private void RolleUmschalten(string rolle)
    {
        if (!_mitarbRollen.Remove(rolle))
            _mitarbRollen.Add(rolle);
    }

    private async Task MitarbeiterSpeichernAsync()
    {
        _fehler = null;
        try
        {
            var antwort = _mitarbBearb is null
                ? await Http.PostAsJsonAsync("api/mitarbeiter", new MitarbeiterAnlegen(_mitarbKonto, _mitarbName))
                : await Http.PutAsJsonAsync($"api/mitarbeiter/{_mitarbBearb.Id}",
                    new MitarbeiterAendern(_mitarbName, _mitarbEmail, _mitarbRollen.ToList(), _mitarbAktiv));
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            MitarbeiterFormSchliessen();
            _mitarbeiter = await Http.GetFromJsonAsync<List<MitarbeiterEintrag>>("api/mitarbeiter") ?? [];
        }
        catch (Exception ex)
        {
            _fehler = $"Benutzer konnte nicht gespeichert werden: {ex.Message}";
        }
    }

    private async Task MitarbeiterLoeschenAsync()
    {
        if (_mitarbBearb is null)
            return;
        _fehler = null;
        var antwort = await Http.DeleteAsync($"api/mitarbeiter/{_mitarbBearb.Id}");
        if (!antwort.IsSuccessStatusCode)
        {
            _fehler = await antwort.Content.ReadAsStringAsync();
            return;
        }
        MitarbeiterFormSchliessen();
        _mitarbeiter = await Http.GetFromJsonAsync<List<MitarbeiterEintrag>>("api/mitarbeiter") ?? [];
    }

    private class ServerFormular
    {
        public string Alias { get; set; } = "";
        public string Url { get; set; } = "";
        public string PruefMandant { get; set; } = "";
        public bool Aktiv { get; set; } = true;
    }
}
