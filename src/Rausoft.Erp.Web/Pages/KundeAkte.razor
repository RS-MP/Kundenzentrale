@page "/kunden/{Id:int}"
@inject HttpClient Http

<PageTitle>@(_kunde?.Firmenname ?? "Kundenakte") · Kundenzentrale</PageTitle>

@if (_fehler is not null)
{
    <div class="fehler">@_fehler</div>
}
else if (_kunde is null)
{
    <div class="leer-hinweis">Lade Kundenakte …</div>
}
else
{
    <div class="akte-kopf">
        <div class="seitenkopf" style="margin-bottom:2px">
            <h1>@_kunde.Firmenname</h1>
            <span class="status @(_kunde.Kategorie == "Kunde" ? "gut" : _kunde.Kategorie == "Zu klären" ? "warnung" : "")">@_kunde.Kategorie</span>
            @if (_kunde.ArchiviertAm is not null)
            {
                <span class="status warnung">Archiv seit @_kunde.ArchiviertAm.Value.ToLocalTime().ToString("dd.MM.yyyy")</span>
            }
            @if (_kunde.Status == "Inaktiv")
            {
                <span class="status kritisch">in Odoo archiviert</span>
            }
            <span style="flex:1"></span>
            @* Archivieren ist eine seltene Aktion → dezenter Kleinknopf; das
               Zurückholen ist im Archiv-Kontext die Hauptaktion und bleibt sichtbar. *@
            <button class="knopf sekundaer @(_kunde.ArchiviertAm is null ? "klein" : "")" @onclick="ArchivUmschaltenAsync">
                @(_kunde.ArchiviertAm is null ? "Ins Archiv" : "Aus dem Archiv holen")
            </button>
        </div>
        <p class="faktenzeile2">
            @if (_kunde.Merkmale is not null)
            {
                <span class="krittext" style="font-weight:600">@_kunde.Merkmale</span>
                @if (_kunde.MerkmalePruefen)
                {
                    <span class="warntext" title="Die Kundendaten haben sich in Odoo geändert — bitte prüfen, ob das Merkmal noch stimmt."> (prüfen)</span>
                }
                <span class="trenn">·</span>
            }
            Kunden-Nr. <b>@_kunde.Kundennummer</b>
            @if (_kunde.Betriebsart is not null)
            {
                <span class="trenn">·</span>@_kunde.Betriebsart
            }
            @if (_kunde.ServerAlias is not null)
            {
                <span class="trenn">·</span>
                <span class="status @_kunde.ServerAmpel"
                      title="@(_kunde.ServerHinweis ?? (_kunde.ServerAmpel is null ? "Noch nicht geprüft" : "Server in Ordnung"))">Server <b>@_kunde.ServerAlias</b></span>
                @if (_kunde.ServerAmpel is "kritisch" or "warnung" && _kunde.ServerHinweis is not null)
                {
                    <span class="trenn">·</span>
                    <span class="@(_kunde.ServerAmpel == "kritisch" ? "krittext" : "")" style="font-weight:600">@_kunde.ServerHinweis</span>
                }
            }
            @if (_kunde.Individualentwicklung is not null)
            {
                <span class="trenn">·</span>
                <span class="merkmal" title="@_kunde.Individualentwicklung">Individualentwicklung</span>
            }
            @if (_kunde.RechnungsempfaengerPartner is not null)
            {
                <span class="trenn">·</span><span>Endkunde via <a href="partner/@_kunde.RechnungsempfaengerPartnerId">@_kunde.RechnungsempfaengerPartner</a> — Rechnung an Partner</span>
            }
            else if (_kunde.VermitteltDurchPartner is not null)
            {
                <span class="trenn">·</span><span>vermittelt durch <a href="partner/@_kunde.VermitteltDurchPartnerId">@_kunde.VermitteltDurchPartner</a></span>
            }
            @if (_kunde.AuchPartnerId is not null)
            {
                <span class="trenn">·</span><span>ist auch Partner: <a href="partner/@_kunde.AuchPartnerId">@_kunde.AuchPartnerName</a></span>
            }
            @if (_kunde.UStIdNr is not null)
            {
                <span class="trenn">·</span><span>USt-IdNr. @_kunde.UStIdNr</span>
            }
            @if (_kunde.Kundengruppe is not null)
            {
                <span class="trenn">·</span>@_kunde.Kundengruppe
            }
        </p>
    </div>

    @* Bewusste Layout-Entscheidung: Verlauf links (breite Spalte), Fakten rechts *@
    <div class="akte">
        <div>
            <div class="karte">
                <div class="karte-kopf">
                    <h2>Verlauf</h2>
                    @if (_verlauf is not null && _verlauf.Count > 0)
                    {
                        <span style="color:var(--muted); font-size:13px">@_verlauf.Count Einträge</span>
                    }
                </div>
                <div class="karte-koerper eng">
                    @if (_verlauf is null || _verlauf.Count == 0)
                    {
                        <div class="leer-hinweis">
                            Noch keine Einträge — Vertragsereignisse erscheinen hier sofort,
                            die Timeline über alle Kanäle (E-Mail, Anrufe, Aufgaben) kommt in Phase 2.
                        </div>
                    }
                    else
                    {
                        <ul class="verlauf2">
                            @foreach (var eintrag in _verlauf)
                            {
                                <li>
                                    <span class="datum">@eintrag.Zeitpunkt.ToLocalTime().ToString("dd.MM.yyyy")</span>
                                    <div>
                                        @if (eintrag.VerweisTyp == "Vertrag" && eintrag.VerweisId is not null)
                                        {
                                            <a href="vertraege/@eintrag.VerweisId">@eintrag.Betreff</a>
                                        }
                                        else
                                        {
                                            <span>@eintrag.Betreff</span>
                                        }
                                        @if (eintrag.Inhalt is not null)
                                        {
                                            <div class="textzeile">@eintrag.Inhalt</div>
                                        }
                                        @if (VerlaufMeta(eintrag) is { } meta)
                                        {
                                            <div class="paar">@meta</div>
                                        }
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <div>
            <details class="gruppe" open>
                <summary>Betrieb &amp; Lizenzen<span class="zahl">@(_laufendeAbos.Count) Abo@(_laufendeAbos.Count == 1 ? "" : "s")</span></summary>
                <div class="gruppe-inhalt">
                    @if (_laufendeAbos.Count == 0)
                    {
                        <div style="color:var(--muted)">Kein laufendes Abo@(_abos?.Count > 0 ? $" ({_abos.Count} frühere/abgelöste)" : "").</div>
                    }
                    @foreach (var abo in _laufendeAbos)
                    {
                        <div style="padding:4px 0 8px">
                            <div style="display:flex; gap:10px; align-items:baseline">
                                <span style="font-weight:600">@abo.Nummer</span>
                                <span class="status gut" style="font-size:13px">@abo.Status</span>
                                <span style="margin-left:auto; color:var(--muted); font-size:12.5px">@IntervallText(abo.IntervallMonate)</span>
                            </div>
                            @if (abo.LaufzeitBeginn is not null || abo.NaechsteVerlaengerung is not null)
                            {
                                <div class="neben" style="font-variant-numeric:tabular-nums">
                                    @(abo.LaufzeitBeginn is not null ? $"seit {abo.LaufzeitBeginn.Value:dd.MM.yyyy}" : "")@(abo.NaechsteVerlaengerung is not null ? $" · Verlängerung {abo.NaechsteVerlaengerung.Value:dd.MM.yyyy}" : "")
                                </div>
                            }
                            <div class="lizenzblock">
                                @foreach (var position in abo.Positionen)
                                {
                                    <div class="lizenz">
                                        <span>@position.Produkt</span>
                                        @if (position.Menge != 1)
                                        {
                                            <span class="menge">@position.Menge.ToString("0.#") ×</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </details>

            <details class="gruppe" open>
                <summary>Verträge<span class="zahl">@(_vertraege?.Count ?? 0)</span></summary>
                <div class="gruppe-inhalt">
                    @if (_vertraege is null || _vertraege.Count == 0)
                    {
                        <div style="color:var(--muted)">Keine Verträge — <a href="vertraege">im Bereich Verträge anlegen</a>.</div>
                    }
                    @foreach (var vertrag in _vertraege ?? [])
                    {
                        <div style="padding:6px 0; border-bottom:1px dashed var(--border)">
                            <div style="display:flex; gap:10px; align-items:baseline">
                                <a href="vertraege/@vertrag.Id" style="font-weight:600">@vertrag.Vertragsnummer</a>
                                <span class="status @StatusKlasse(vertrag.Status)" style="font-size:13px">@vertrag.Status</span>
                                <span style="margin-left:auto; color:var(--muted); font-size:12.5px; font-variant-numeric:tabular-nums">
                                    @(vertrag.NaechstesEnde is not null ? $"Ende {vertrag.NaechstesEnde.Value:dd.MM.yyyy}" : "")
                                </span>
                            </div>
                            <div class="neben" style="display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:3px">
                                <TypPills Bestandteile="vertrag.Bestandteile" />
                                @if (vertrag.AktuellerStand is { } stand)
                                {
                                    <span title="Jüngstes Dokument der Akte: @stand.Bezeichnung">Stand @(vertrag.Bestandteile.Sum(b => b.Anzahl) > 1 ? $"{stand.Bezeichnung} · " : "")@stand.Datum.ToString("dd.MM.yyyy")</span>
                                }
                            </div>
                            @foreach (var info in vertrag.Kurzinfos)
                            {
                                <div class="neben" style="color:var(--ink2)">@info</div>
                            }
                        </div>
                    }
                    @if (_vorlagen.Count > 0)
                    {
                        <button class="knopf sekundaer" style="margin-top:10px" @onclick="() => _fensterOffen = true">+ Vertrag aus Vorlage</button>
                    }
                </div>
            </details>

            <details class="gruppe" open>
                <summary>Ansprechpartner<span class="zahl">@_wichtige.Count von @(_kunde.Ansprechpartner.Count)</span></summary>
                <div class="gruppe-inhalt">
                    @foreach (var person in _wichtige)
                    {
                        @PersonZeile(person)
                    }
                    @if (_weitere.Count > 0)
                    {
                        <button class="mehr" @onclick="() => _weitereOffen = !_weitereOffen">
                            @(_weitereOffen ? "weniger anzeigen" : WeitereText())
                        </button>
                        @if (_weitereOffen)
                        {
                            @foreach (var person in _weitere)
                            {
                                @PersonZeile(person)
                            }
                        }
                    }
                </div>
            </details>

            <details class="gruppe">
                <summary>Stammdaten &amp; Adressen</summary>
                <div class="gruppe-inhalt">
                    @foreach (var adresse in _kunde.Adressen)
                    {
                        <div class="zeile2">
                            <span class="l">@adresse.Typ</span>
                            <span class="r">@adresse.Strasse@(adresse.Zusatz is not null ? $" ({adresse.Zusatz})" : ""), @adresse.Plz @adresse.Ort@(adresse.Land != "DE" ? $" · {adresse.Land}" : "")</span>
                        </div>
                    }
                    @if (_kunde.OdooId is not null)
                    {
                        <div class="zeile2"><span class="l">Odoo-Referenz</span><span class="r">@_kunde.OdooId</span></div>
                    }
                    @if (_kunde.Notiz is not null)
                    {
                        <div class="zeile2"><span class="l">Notiz</span><span class="r">@_kunde.Notiz</span></div>
                    }
                    <div style="border-top:1px dashed var(--border); margin-top:8px; padding-top:8px">
                        <div style="color:var(--muted); font-size:12.5px; margin-bottom:6px">
                            Betrieb: Server &amp; Mandanten-Kennung (intern)
                        </div>
                        <div style="display:flex; gap:8px">
                            <select style="flex:1" @bind="_serverAuswahl">
                                <option value="">— kein Server —</option>
                                @foreach (var server in _serverListe)
                                {
                                    <option value="@server.Id">@server.Alias</option>
                                }
                            </select>
                            <input type="text" style="flex:1" @bind="_mandantenKennung" placeholder="Mandanten-Kennung" />
                            <button class="knopf sekundaer" @onclick="ServerSpeichernAsync">Speichern</button>
                        </div>
                    </div>
                    <div style="border-top:1px dashed var(--border); margin-top:8px; padding-top:8px">
                        <div style="color:var(--muted); font-size:12.5px; margin-bottom:6px">
                            Merkmale (Auswahl anklicken, bleiben bis zur bewussten Änderung)
                        </div>
                        <div class="chips" style="margin-bottom:8px">
                            @foreach (var merkmal in _merkmalListe)
                            {
                                <button class="chip @(_gewaehlteMerkmale.Contains(merkmal) ? "aktiv" : "")"
                                        @onclick="() => MerkmalUmschalten(merkmal)">@merkmal</button>
                            }
                        </div>
                        <div style="display:flex; gap:8px">
                            <input type="text" style="flex:1" @bind="_neuesMerkmal" placeholder="Neues Merkmal für die Auswahl …" />
                            <button class="knopf sekundaer" @onclick="MerkmalErgaenzenAsync">Hinzufügen</button>
                            <button class="knopf" @onclick="MerkmaleSpeichernAsync">Speichern</button>
                        </div>
                        @if (_merkmalGespeichert)
                        {
                            <div style="color:var(--good); font-size:13px; margin-top:4px">✓ gespeichert</div>
                        }
                    </div>
                    <div style="border-top:1px dashed var(--border); margin-top:8px; padding-top:8px">
                        <div style="color:var(--muted); font-size:12.5px; margin-bottom:6px">
                            Individualentwicklung — was wurde für diesen Kunden entwickelt? (leer = keine)
                        </div>
                        <div style="display:flex; gap:8px; align-items:flex-start">
                            <textarea rows="2" style="flex:1" @bind="_individualentwicklung"
                                      placeholder="z. B. Zoll-Schnittstelle Schweiz, Sonderreport XY …"></textarea>
                            <button class="knopf" @onclick="IndividualentwicklungSpeichernAsync">Speichern</button>
                        </div>
                        @if (_individualGespeichert)
                        {
                            <div style="color:var(--good); font-size:13px; margin-top:4px">✓ gespeichert</div>
                        }
                    </div>
                </div>
            </details>
        </div>
    </div>
}

@if (_fensterOffen && _kunde is not null)
{
    <VertragAusVorlageFenster KundeId="Id" Vorlagen="_vorlagen" Abos="_abos"
                              Ansprechpartner="_kunde.Ansprechpartner" Geschlossen="FensterGeschlossenAsync" />
}

@code {
    [Parameter] public int Id { get; set; }

    private KundeDetail? _kunde;
    private List<VerlaufEintrag>? _verlauf;
    private List<VertragListenEintrag>? _vertraege;
    private List<AboEintrag>? _abos;
    private List<AboEintrag> _laufendeAbos = [];
    private List<AnsprechpartnerEintrag> _wichtige = [];
    private List<AnsprechpartnerEintrag> _weitere = [];
    private bool _weitereOffen;
    private List<ServerEintrag> _serverListe = [];
    private string _serverAuswahl = "";
    private string _mandantenKennung = "";
    private List<VorlageAuswahl> _vorlagen = [];
    private List<string> _merkmalListe = [];
    private HashSet<string> _gewaehlteMerkmale = [];
    private string _neuesMerkmal = "";
    private bool _merkmalGespeichert;
    private string _individualentwicklung = "";
    private bool _individualGespeichert;
    private string? _fehler;

    protected override async Task OnParametersSetAsync()
    {
        _fehler = null;
        _kunde = null;
        _weitereOffen = false;
        try
        {
            _kunde = await Http.GetFromJsonAsync<KundeDetail>($"api/kunden/{Id}");
            _merkmalListe = await Http.GetFromJsonAsync<List<string>>("api/merkmale") ?? [];
            _gewaehlteMerkmale = (_kunde?.Merkmale ?? "")
                .Split('·', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            // Bereits vergebene Merkmale, die (noch) nicht in der Stammliste stehen, mit anzeigen
            foreach (var vorhanden in _gewaehlteMerkmale.Where(m => !_merkmalListe.Contains(m, StringComparer.OrdinalIgnoreCase)))
                _merkmalListe.Add(vorhanden);
            _merkmalGespeichert = false;
            _individualentwicklung = _kunde?.Individualentwicklung ?? "";
            _individualGespeichert = false;
            _verlauf = await Http.GetFromJsonAsync<List<VerlaufEintrag>>($"api/kunden/{Id}/verlauf");
            var vertraege = await Http.GetFromJsonAsync<SeitenErgebnis<VertragListenEintrag>>(
                $"api/vertraege?kundeId={Id}&seite=1&proSeite=50");
            _vertraege = vertraege?.Eintraege;
            _abos = await Http.GetFromJsonAsync<List<AboEintrag>>($"api/kunden/{Id}/abos");
            _laufendeAbos = _abos?.Where(a => a.Status == "Laufend").ToList() ?? [];
            _vorlagen = await Http.GetFromJsonAsync<List<VorlageAuswahl>>("api/vertraege/vorlagen") ?? [];
            _serverListe = await Http.GetFromJsonAsync<List<ServerEintrag>>("api/server") ?? [];
            _serverAuswahl = _kunde?.ServerId?.ToString() ?? "";
            _mandantenKennung = _kunde?.MandantenKennung ?? "";

            // Wichtige zuerst: aktive Ansprechpartner mit Rolle; ohne Rollen die ersten zwei.
            var aktive = _kunde!.Ansprechpartner.Where(a => a.Aktiv).ToList();
            _wichtige = aktive.Where(a => a.Rollen.Count > 0).ToList();
            if (_wichtige.Count == 0)
                _wichtige = aktive.Where(a => !IstSammelpostfach(a)).Take(2).ToList();
            _weitere = _kunde.Ansprechpartner
                .Where(a => !_wichtige.Contains(a))
                .OrderBy(IstSammelpostfach)          // Sammelpostfächer ans Ende
                .ThenByDescending(a => a.Aktiv)
                .ToList();
        }
        catch (Exception ex)
        {
            _fehler = $"Kundenakte konnte nicht geladen werden: {ex.Message}";
        }
    }

    private static bool IstSammelpostfach(AnsprechpartnerEintrag a) =>
        a.Anrede == "" && string.IsNullOrEmpty(a.Vorname);

    private string WeitereText()
    {
        var sammel = _weitere.Count(IstSammelpostfach);
        return sammel > 0
            ? $"{_weitere.Count} weitere anzeigen (davon {sammel} Sammelpostfächer)"
            : $"{_weitere.Count} weitere anzeigen";
    }

    private static string? VerlaufMeta(VerlaufEintrag eintrag)
    {
        var teile = new List<string> { eintrag.Typ };
        if (eintrag.Mitarbeiter is not null && eintrag.Ansprechpartner is not null)
            teile.Add($"{eintrag.Mitarbeiter} ↔ {eintrag.Ansprechpartner}");
        else if (eintrag.Mitarbeiter is not null)
            teile.Add(eintrag.Mitarbeiter);
        return string.Join(" · ", teile);
    }

    private RenderFragment PersonZeile(AnsprechpartnerEintrag person) => @<div class="person @(person.Aktiv ? "" : "inaktiv")">
        <div class="name">
            @person.Anrede @person.Titel @person.Vorname @person.Nachname
            @if (person.Rollen.Count > 0 || person.Position is not null)
            {
                <span style="color:var(--muted); font-size:12px; font-weight:400; margin-left:6px">
                    @string.Join(" · ", new[] { person.Position }.Where(p => p is not null).Concat(person.Rollen))
                </span>
            }
        </div>
        <div class="details">
            @if (person.Email is not null)
            {
                <a href="mailto:@person.Email">@person.Email</a>
            }
            @if (person.TelefonFestnetz is not null)
            {
                <span> · @person.TelefonFestnetz</span>
            }
        </div>
    </div>;

    private bool _fensterOffen;

    private async Task FensterGeschlossenAsync(bool erstellt)
    {
        _fensterOffen = false;
        if (erstellt)
            await OnParametersSetAsync();   // Verträge + Verlauf neu laden
    }

    private async Task ServerSpeichernAsync()
    {
        _fehler = null;
        try
        {
            int? serverId = int.TryParse(_serverAuswahl, out var id) ? id : null;
            var antwort = await Http.PutAsJsonAsync($"api/kunden/{Id}/server",
                new KundeServerZuordnung(serverId, string.IsNullOrWhiteSpace(_mandantenKennung) ? null : _mandantenKennung.Trim()));
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            await OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            _fehler = $"Server-Zuordnung fehlgeschlagen: {ex.Message}";
        }
    }

    private async Task ArchivUmschaltenAsync()
    {
        _fehler = null;
        try
        {
            var antwort = await Http.PutAsJsonAsync($"api/kunden/{Id}/archiv",
                new ArchivAenderung(_kunde!.ArchiviertAm is null));
            antwort.EnsureSuccessStatusCode();
            await OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            _fehler = $"Archiv-Änderung fehlgeschlagen: {ex.Message}";
        }
    }

    private void MerkmalUmschalten(string merkmal)
    {
        if (!_gewaehlteMerkmale.Remove(merkmal))
            _gewaehlteMerkmale.Add(merkmal);
    }

    private async Task MerkmalErgaenzenAsync()
    {
        var name = _neuesMerkmal.Trim();
        if (name.Length == 0)
            return;
        _fehler = null;
        try
        {
            var antwort = await Http.PostAsJsonAsync("api/merkmale", new MerkmalAnlegen(name));
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            if (!_merkmalListe.Contains(name, StringComparer.OrdinalIgnoreCase))
                _merkmalListe.Add(name);
            _gewaehlteMerkmale.Add(name);
            _neuesMerkmal = "";
        }
        catch (Exception ex)
        {
            _fehler = $"Merkmal konnte nicht angelegt werden: {ex.Message}";
        }
    }

    private async Task MerkmaleSpeichernAsync()
    {
        _fehler = null;
        try
        {
            var wert = _gewaehlteMerkmale.Count == 0 ? null : string.Join(" · ", _gewaehlteMerkmale.OrderBy(m => m));
            var antwort = await Http.PutAsJsonAsync($"api/kunden/{Id}/merkmale", new MerkmaleAenderung(wert));
            antwort.EnsureSuccessStatusCode();
            await OnParametersSetAsync();
            _merkmalGespeichert = true;
        }
        catch (Exception ex)
        {
            _fehler = $"Merkmal konnte nicht gespeichert werden: {ex.Message}";
        }
    }

    private async Task IndividualentwicklungSpeichernAsync()
    {
        _fehler = null;
        try
        {
            var wert = string.IsNullOrWhiteSpace(_individualentwicklung) ? null : _individualentwicklung.Trim();
            var antwort = await Http.PutAsJsonAsync($"api/kunden/{Id}/individualentwicklung",
                new IndividualentwicklungAenderung(wert));
            antwort.EnsureSuccessStatusCode();
            await OnParametersSetAsync();
            _individualGespeichert = true;
        }
        catch (Exception ex)
        {
            _fehler = $"Individualentwicklung konnte nicht gespeichert werden: {ex.Message}";
        }
    }

    private static string IntervallText(int monate) => monate switch
    {
        1 => "monatlich",
        3 => "vierteljährlich",
        6 => "halbjährlich",
        12 => "jährlich",
        _ => $"alle {monate} Monate",
    };

    private static string StatusKlasse(string status) => status switch
    {
        "Aktiv" => "gut",
        "Gekündigt" => "warnung",
        "Beendet" => "kritisch",
        _ => "",
    };
}
