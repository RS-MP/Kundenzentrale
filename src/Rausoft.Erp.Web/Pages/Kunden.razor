@page "/kunden"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Kunden · Kundenzentrale</PageTitle>

<div class="seitenkopf">
    <h1>Kunden</h1>
    @if (_ergebnis is not null)
    {
        <span class="untertitel">@_ergebnis.Gesamt @(_filter switch { "kunden" => "Kunden", "ehemalige" => "gekündigte/ehemalige Kunden", "interessenten" => "Interessenten", "zuklaeren" => "zu klären", "einmalbestellung" => "Einmalbestellungen", "archiv" => "im Archiv", "partner" => "über Partner", _ => "Kontakte" })</span>
    }
</div>

@if (_fehler is not null)
{
    <div class="fehler">@_fehler</div>
}

<div class="werkzeugleiste">
    <input type="search" placeholder="Firma oder Kundennummer …"
           @bind="_suche" @bind:event="oninput" @onkeydown="BeiTaste" />
    <div class="chips">
        <button class="chip @(_filter == "kunden" ? "aktiv" : "")" @onclick='() => Navigiere("kunden")'>Kunden</button>
        <button class="chip @(_filter == "ehemalige" ? "aktiv" : "")" @onclick='() => Navigiere("ehemalige")'>Gekündigt/Ehemalig</button>
        <button class="chip @(_filter == "interessenten" ? "aktiv" : "")" @onclick='() => Navigiere("interessenten")'>Interessenten</button>
        <button class="chip @(_filter == "zuklaeren" ? "aktiv" : "")" @onclick='() => Navigiere("zuklaeren")'>Zu klären</button>
        <button class="chip @(_filter == "einmalbestellung" ? "aktiv" : "")" @onclick='() => Navigiere("einmalbestellung")'>Einmalbestellung</button>
        <button class="chip @(_filter == "alle" ? "aktiv" : "")" @onclick='() => Navigiere("alle")'>Alle</button>
        <button class="chip @(_filter == "partner" ? "aktiv" : "")" @onclick='() => Navigiere("partner")'>Mit Partner</button>
        <button class="chip @(_filter == "archiv" ? "aktiv" : "")" @onclick='() => Navigiere("archiv")'>Archiv</button>
    </div>
</div>

<div class="karte">
    <div class="karte-koerper eng">
        @if (_ergebnis is null)
        {
            <div class="leer-hinweis">Lade Kunden …</div>
        }
        else if (_ergebnis.Eintraege.Count == 0)
        {
            <div class="leer-hinweis">Keine Kunden gefunden.</div>
        }
        else
        {
            <table class="liste">
                <thead>
                    <tr>
                        <th style="width:90px">Nr.</th>
                        <th>Firma</th>
                        <th style="width:180px">Ort</th>
                        <th style="width:150px">Server</th>
                        <th style="width:150px">Kategorie</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kunde in _ergebnis.Eintraege)
                    {
                        <tr @onclick='() => Navigation.NavigateTo($"kunden/{kunde.Id}")'>
                            <td>@kunde.Kundennummer</td>
                            <td>
                                <span class="haupt">@kunde.Firmenname</span>
                                @if (kunde.Merkmale is not null)
                                {
                                    <span class="krittext" style="margin-left:8px; font-size:12.5px">@kunde.Merkmale</span>
                                }
                                @if (Nebenzeile(kunde) is { } neben)
                                {
                                    <div class="neben">@neben</div>
                                }
                            </td>
                            <td>@kunde.Ort</td>
                            <td>
                                @if (kunde.ServerAlias is not null)
                                {
                                    <span class="status @kunde.ServerAmpel"
                                          title="@(kunde.ServerHinweis ?? (kunde.ServerAmpel is null ? "Noch nicht geprüft" : "Server in Ordnung"))">@kunde.ServerAlias</span>
                                    @if (kunde.ServerAmpel is "kritisch" or "warnung" && kunde.ServerHinweis is not null)
                                    {
                                        <div class="neben">@kunde.ServerHinweis</div>
                                    }
                                }
                            </td>
                            <td>
                                <span class="status @KategorieKlasse(kunde.Kategorie)">@kunde.Kategorie</span>
                                @if (kunde.Status == "Inaktiv")
                                {
                                    <div class="neben">in Odoo archiviert</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="paging">
                <button class="knopf sekundaer" disabled="@(_ergebnis.Seite <= 1)"
                        @onclick="() => Navigiere(seite: _ergebnis.Seite - 1)">‹ Zurück</button>
                <span>Seite @_ergebnis.Seite von @_ergebnis.SeitenAnzahl</span>
                <button class="knopf sekundaer" disabled="@(_ergebnis.Seite >= _ergebnis.SeitenAnzahl)"
                        @onclick="() => Navigiere(seite: _ergebnis.Seite + 1)">Weiter ›</button>
                <span class="fueller"></span>
                <span>25 pro Seite</span>
            </div>
        }
    </div>
</div>

@code {
    // Filter, Suche und Seite leben in der URL — so überlebt die Auswahl
    // den Sprung in die Akte und zurück (Browser-Zurück, Lesezeichen, Teilen).
    [Parameter, SupplyParameterFromQuery(Name = "filter")] public string? FilterParam { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "suche")] public string? SucheParam { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "seite")] public int SeiteParam { get; set; }

    private SeitenErgebnis<KundeListenEintrag>? _ergebnis;
    private string _suche = "";
    private string _filter = "kunden"; // Standardsicht: echte Kunden (laufendes Abo/aktiver Vertrag)
    private string? _fehler;

    protected override Task OnParametersSetAsync()
    {
        _filter = string.IsNullOrEmpty(FilterParam) ? "kunden" : FilterParam;
        _suche = SucheParam ?? "";
        return LadenAsync(Math.Max(1, SeiteParam));
    }

    private void Navigiere(string? filter = null, int seite = 1)
    {
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["filter"] = (filter ?? _filter) == "kunden" ? null : filter ?? _filter,
            ["suche"] = string.IsNullOrWhiteSpace(_suche) ? null : _suche.Trim(),
            ["seite"] = seite <= 1 ? null : seite,
        }));
    }

    private static string? Nebenzeile(KundeListenEintrag kunde)
    {
        var teile = new[] { kunde.Betriebsart, string.IsNullOrEmpty(kunde.PartnerHinweis) ? null : kunde.PartnerHinweis }
            .Where(t => t is not null);
        var text = string.Join(" · ", teile);
        return text.Length == 0 ? null : text;
    }

    private async Task LadenAsync(int seite)
    {
        _fehler = null;
        try
        {
            var kategorie = _filter is "kunden" or "ehemalige" or "interessenten" or "zuklaeren" or "einmalbestellung" or "archiv" ? _filter : "";
            var mitPartner = _filter == "partner";
            _ergebnis = await Http.GetFromJsonAsync<SeitenErgebnis<KundeListenEintrag>>(
                $"api/kunden?suche={Uri.EscapeDataString(_suche.Trim())}&kategorie={kategorie}" +
                $"&mitPartner={mitPartner}&seite={seite}&proSeite=25");
        }
        catch (Exception ex)
        {
            _fehler = $"Kunden konnten nicht geladen werden: {ex.Message}";
        }
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            Navigiere();
        return Task.CompletedTask;
    }

    private static string KategorieKlasse(string kategorie) => kategorie switch
    {
        "Kunde" => "gut",
        "Zu klären" => "warnung",
        _ => "",
    };
}
