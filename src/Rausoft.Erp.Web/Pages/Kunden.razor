@page "/kunden"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Kunden · Kundenzentrale</PageTitle>

<div class="seitenkopf">
    <h1>Kunden</h1>
    @if (_ergebnis is not null)
    {
        <span class="untertitel">@_ergebnis.Gesamt @(_filter switch { "kunden" => "Kunden", "interessenten" => "Interessenten", "Partner" => "über Partner", _ => "Kontakte" })</span>
    }
</div>

@if (_fehler is not null)
{
    <div class="fehler">@_fehler</div>
}

<div class="werkzeugleiste">
    <input type="search" placeholder="Firma oder Kundennummer …"
           @bind="_suche" @bind:event="oninput" @onkeydown="BeiTaste" />
    <div class="chips">
        <button class="chip @(_filter == "kunden" ? "aktiv" : "")" @onclick='() => FilterAsync("kunden")'>Kunden</button>
        <button class="chip @(_filter == "interessenten" ? "aktiv" : "")" @onclick='() => FilterAsync("interessenten")'>Interessenten</button>
        <button class="chip @(_filter == "" ? "aktiv" : "")" @onclick='() => FilterAsync("")'>Alle</button>
        <button class="chip @(_filter == "Partner" ? "aktiv" : "")" @onclick='() => FilterAsync("Partner")'>Mit Partner</button>
    </div>
</div>

<div class="karte">
    <div class="karte-koerper eng">
        @if (_ergebnis is null)
        {
            <div class="leer-hinweis">Lade Kunden …</div>
        }
        else if (_ergebnis.Eintraege.Count == 0)
        {
            <div class="leer-hinweis">Keine Kunden gefunden.</div>
        }
        else
        {
            <table class="liste">
                <thead>
                    <tr>
                        <th style="width:90px">Nr.</th>
                        <th>Firma</th>
                        <th style="width:180px">Ort</th>
                        <th style="width:150px">Kategorie</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var kunde in _ergebnis.Eintraege)
                    {
                        <tr @onclick='() => Navigation.NavigateTo($"kunden/{kunde.Id}")'>
                            <td>@kunde.Kundennummer</td>
                            <td>
                                <span class="haupt">@kunde.Firmenname</span>
                                @if (Nebenzeile(kunde) is { } neben)
                                {
                                    <div class="neben">@neben</div>
                                }
                            </td>
                            <td>@kunde.Ort</td>
                            <td>
                                <span class="status @KategorieKlasse(kunde.Kategorie)">@kunde.Kategorie</span>
                                @if (kunde.Status == "Inaktiv")
                                {
                                    <div class="neben">in Odoo archiviert</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="paging">
                <button class="knopf sekundaer" disabled="@(_ergebnis.Seite <= 1)"
                        @onclick="() => LadenAsync(_ergebnis.Seite - 1)">‹ Zurück</button>
                <span>Seite @_ergebnis.Seite von @_ergebnis.SeitenAnzahl</span>
                <button class="knopf sekundaer" disabled="@(_ergebnis.Seite >= _ergebnis.SeitenAnzahl)"
                        @onclick="() => LadenAsync(_ergebnis.Seite + 1)">Weiter ›</button>
                <span class="fueller"></span>
                <span>25 pro Seite</span>
            </div>
        }
    </div>
</div>

@code {
    private SeitenErgebnis<KundeListenEintrag>? _ergebnis;
    private string _suche = "";
    private string _filter = "kunden"; // Standardsicht: echte Kunden (laufendes Abo/aktiver Vertrag)
    private string? _fehler;

    protected override Task OnInitializedAsync() => LadenAsync(1);

    private static string? Nebenzeile(KundeListenEintrag kunde)
    {
        var teile = new[] { kunde.Betriebsart, string.IsNullOrEmpty(kunde.PartnerHinweis) ? null : kunde.PartnerHinweis }
            .Where(t => t is not null);
        var text = string.Join(" · ", teile);
        return text.Length == 0 ? null : text;
    }

    private async Task LadenAsync(int seite)
    {
        _fehler = null;
        try
        {
            var kategorie = _filter is "kunden" or "interessenten" ? _filter : "";
            var mitPartner = _filter == "Partner";
            _ergebnis = await Http.GetFromJsonAsync<SeitenErgebnis<KundeListenEintrag>>(
                $"api/kunden?suche={Uri.EscapeDataString(_suche.Trim())}&kategorie={kategorie}" +
                $"&mitPartner={mitPartner}&seite={seite}&proSeite=25");
        }
        catch (Exception ex)
        {
            _fehler = $"Kunden konnten nicht geladen werden: {ex.Message}";
        }
    }

    private Task FilterAsync(string filter)
    {
        _filter = filter;
        return LadenAsync(1);
    }

    private Task BeiTaste(KeyboardEventArgs e) =>
        e.Key == "Enter" ? LadenAsync(1) : Task.CompletedTask;

    private static string KategorieKlasse(string kategorie) => kategorie switch
    {
        "Kunde" => "gut",
        "Ehemaliger Kunde" => "warnung",
        _ => "",
    };
}
