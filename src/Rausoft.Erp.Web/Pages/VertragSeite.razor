@page "/vertraege/{Id:int}"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>@(_vertrag?.Vertragsnummer ?? "Vertrag") · Kundenzentrale</PageTitle>

@if (_fehler is not null)
{
    <div class="fehler">@_fehler</div>
}
@if (_vertrag is null)
{
    @if (_fehler is null)
    {
        <div class="leer-hinweis">Lade Vertrag …</div>
    }
}
else
{
    <div class="akte-kopf">
        <div class="seitenkopf">
            <h1>Vertrag @_vertrag.Vertragsnummer</h1>
            <span class="untertitel">
                <a href="kunden/@_vertrag.KundeId">@_vertrag.KundeName</a> · Kunden-Nr. @_vertrag.Kundennummer
            </span>
        </div>
        <p class="faktenzeile2">
            <span class="status @StatusKlasse(_vertrag.Status)">@_vertrag.Status</span>
            @if (_vertrag.NaechstesEnde is not null)
            {
                <span class="trenn">·</span><span>Nächstmögliches Ende @_vertrag.NaechstesEnde.Value.ToString("dd.MM.yyyy")</span>
            }
            else
            {
                <span class="trenn">·</span><span class="warntext">Laufzeit fehlt — bitte nachpflegen</span>
            }
            @if (_vertrag.Bestandteile.Count > 0)
            {
                <span class="trenn">·</span>@string.Join(" · ", _vertrag.Bestandteile.Select(b => b.Typ).Distinct())
            }
        </p>
    </div>

    <div class="akte">
        <div>
            <div class="karte">
                <div class="karte-kopf">
                    <h2>Bestandteile &amp; Dokumente</h2>
                    <button class="knopf sekundaer" @onclick="() => _bestandteilOffen = !_bestandteilOffen">+ Bestandteil</button>
                </div>
                <div class="karte-koerper">
                    @if (_bestandteilOffen)
                    {
                        <div class="formular" style="margin-bottom:16px">
                            <label>
                                Typ
                                <select @bind="_neuerBestandteil.Typ">
                                    <option>Lizenzvertrag</option>
                                    <option>Wartungsvertrag</option>
                                    <option>AVV</option>
                                    <option>NDA</option>
                                    <option>Sondervereinbarung</option>
                                    <option>Nachtrag</option>
                                    <option>Sonstiges</option>
                                </select>
                            </label>
                            <label>
                                Titel
                                <input type="text" @bind="_neuerBestandteil.Titel" placeholder="z. B. Lizenzvertrag ID prove" />
                            </label>
                            <label>
                                Unterzeichnet am
                                <input type="date" @bind="_neuerBestandteil.UnterzeichnetAm" />
                            </label>
                            <label class="breit">
                                Beschreibung
                                <textarea rows="2" @bind="_neuerBestandteil.Beschreibung"></textarea>
                            </label>
                            <div class="formular-aktionen breit">
                                <button class="knopf" @onclick="BestandteilAnlegenAsync">Hinzufügen</button>
                            </div>
                        </div>
                    }

                    @if (_vertrag.Bestandteile.Count == 0)
                    {
                        <div class="leer-hinweis">
                            Noch keine Bestandteile — typischer Abschluss: Lizenzvertrag inkl. AVV,
                            optional NDA und Sondervereinbarungen.
                        </div>
                    }
                    @foreach (var bestandteil in _vertrag.Bestandteile)
                    {
                        <div style="margin-bottom:18px">
                            @* Einheitlich: der Typ ist immer die fette Überschrift, der Titel dezent dahinter *@
                            <div style="display:flex; align-items:baseline; gap:8px; flex-wrap:wrap">
                                <strong>@bestandteil.Typ</strong>
                                @if (!string.Equals(bestandteil.Titel, bestandteil.Typ, StringComparison.OrdinalIgnoreCase))
                                {
                                    <span style="color:var(--ink2)">@bestandteil.Titel</span>
                                }
                                @if (bestandteil.UnterzeichnetAm is not null)
                                {
                                    <span style="color:var(--muted)">unterzeichnet @bestandteil.UnterzeichnetAm.Value.ToString("dd.MM.yyyy")</span>
                                }
                            </div>
                            @if (bestandteil.Beschreibung is not null)
                            {
                                <div style="color:var(--ink2); margin:4px 0">@bestandteil.Beschreibung</div>
                            }
                            @foreach (var dokument in bestandteil.Dokumente)
                            {
                                <div class="dokument">
                                    <span class="pill">v@(dokument.Version)</span>
                                    <span class="pfad" title="@dokument.Dateipfad">@dokument.DateinameOriginal
                                        <span style="color:var(--muted)"> — @Ordner(dokument.Dateipfad)</span>
                                    </span>
                                    <span class="hash" title="SHA-256: @dokument.Sha256">@dokument.Sha256[..12]…</span>
                                    <button class="knopf sekundaer" @onclick="() => VorschauAsync(dokument)">Ansehen</button>
                                    @if (dokument.OrdnerPfad is not null)
                                    {
                                        <a class="knopf sekundaer" href="@OrdnerLink(dokument.OrdnerPfad)"
                                           title="@dokument.OrdnerPfad — öffnet den Ablage-Ordner im Explorer (falls nichts passiert: Intranet-Dateilinks im Browser freischalten oder „Pfad" nutzen)">Ordner</a>
                                        <button class="knopf sekundaer" @onclick="() => PfadKopierenAsync(dokument)"
                                                title="Vollständigen Dateipfad kopieren — in der Explorer-Adresszeile einfügen öffnet die Datei direkt">
                                            @(_pfadKopiertId == dokument.Id ? "✓ kopiert" : "Pfad")
                                        </button>
                                    }
                                </div>
                            }
                            @if (_versionOffen.Contains(bestandteil.Id))
                            {
                                <div style="display:flex; gap:8px; margin-top:8px">
                                    <input type="text" style="flex:1; font-family:Consolas,monospace; font-size:13px"
                                           placeholder="Pfad relativ zum Ablageverzeichnis, z. B. 2_Wartungsverträge\4228-2.pdf"
                                           @bind="_dokumentPfade[bestandteil.Id]" />
                                    <button class="knopf" @onclick="() => DokumentRegistrierenAsync(bestandteil.Id)">Registrieren</button>
                                    <button class="knopf sekundaer" @onclick="() => _versionOffen.Remove(bestandteil.Id)">Abbrechen</button>
                                </div>
                            }
                            else
                            {
                                <button class="mehr" @onclick="() => _versionOffen.Add(bestandteil.Id)">+ Version hinzufügen</button>
                            }
                        </div>
                    }
                    <div style="color:var(--muted); font-size:12px; margin-top:8px">
                        Dokumente bleiben im Ablageverzeichnis (Administration → Vertragsablage.Verzeichnis).
                        Die Kundenzentrale speichert Pfad + SHA-256-Prüfsumme; Versionen sind unveränderlich.
                    </div>
                </div>
            </div>
        </div>

        <div>
            <div class="karte">
                <div class="karte-kopf"><h2>Stammdaten</h2></div>
                <div class="karte-koerper">
                    <div class="formular">
                        <label>
                            Status
                            <select @bind="_bearbeitung.Status">
                                <option>Entwurf</option>
                                <option>Aktiv</option>
                                <option>Gekündigt</option>
                                <option>Beendet</option>
                            </select>
                        </label>
                        <label>
                            Beginn
                            <input type="date" @bind="_bearbeitung.Beginn" />
                        </label>
                        <label>
                            Mindestlaufzeit (Monate)
                            <input type="number" @bind="_bearbeitung.Mindestlaufzeit" min="0" />
                        </label>
                        <label>
                            Verlängerung (Monate)
                            <input type="number" @bind="_bearbeitung.Verlaengerung" min="0" />
                        </label>
                        <label>
                            Kündigungsfrist (Monate)
                            <input type="number" @bind="_bearbeitung.Kuendigungsfrist" min="0" />
                        </label>
                        <label>
                            Gekündigt zum
                            <input type="date" @bind="_bearbeitung.GekuendigtZum" />
                        </label>
                        <label class="breit">
                            Notiz
                            <textarea rows="3" @bind="_bearbeitung.Notiz"></textarea>
                        </label>
                    </div>
                    <div class="formular-aktionen">
                        <button class="knopf" @onclick="SpeichernAsync">Speichern</button>
                        @if (_gespeichert)
                        {
                            <span style="color:var(--good)">✓ gespeichert</span>
                        }
                        <span style="flex:1"></span>
                        <button class="knopf sekundaer krittext" @onclick="LoeschenAsync">Vertrag löschen …</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (_vorschauUrl is not null)
{
    <div class="vorschau-overlay" @onclick="VorschauSchliessenAsync">
        <div class="vorschau-fenster" @onclick:stopPropagation="true">
            <div class="vorschau-kopf">
                <span class="titel">@_vorschauTitel</span>
                <a class="knopf sekundaer" href="@_vorschauUrl" target="_blank">In neuem Tab öffnen</a>
                <button class="knopf" @onclick="VorschauSchliessenAsync">Schließen</button>
            </div>
            <iframe src="@_vorschauUrl" title="Dokumentvorschau"></iframe>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private VertragDetail? _vertrag;
    private string? _fehler;
    private bool _gespeichert;
    private bool _bestandteilOffen;
    private readonly Bearbeitung _bearbeitung = new();
    private readonly NeuerBestandteil _neuerBestandteil = new();
    private readonly Dictionary<int, string> _dokumentPfade = [];
    private readonly HashSet<int> _versionOffen = [];

    /// <summary>Übergeordneter Ordner der Datei — unterscheidet gleichnamige Dateien aus verschiedenen Ablage-Ordnern.</summary>
    private static string Ordner(string pfad)
    {
        var teile = pfad.Split('\\', StringSplitOptions.RemoveEmptyEntries);
        return teile.Length >= 2 ? teile[^2] : "";
    }

    private int? _pfadKopiertId;

    // UNC-Ordner als file://-Link (öffnet den Explorer; braucht im Browser
    // freigeschaltete Intranet-Dateilinks, sonst greift „Pfad kopieren")
    private static string OrdnerLink(string ordner)
    {
        try { return new Uri(ordner).AbsoluteUri; }
        catch { return ""; }
    }

    private async Task PfadKopierenAsync(DokumentEintrag dokument)
    {
        var dateiname = dokument.Dateipfad.Split('\\', StringSplitOptions.RemoveEmptyEntries)[^1];
        var voll = $"{dokument.OrdnerPfad}\\{dateiname}";
        if (await JS.InvokeAsync<bool>("zwischenablage.kopieren", voll))
        {
            _pfadKopiertId = dokument.Id;
            _ = EntferneKopiertMarkierungAsync(dokument.Id);
        }
        else
        {
            await JS.InvokeVoidAsync("zwischenablage.anzeigen", voll);
        }
    }

    private async Task EntferneKopiertMarkierungAsync(int dokumentId)
    {
        await Task.Delay(2500);
        if (_pfadKopiertId == dokumentId)
        {
            _pfadKopiertId = null;
            StateHasChanged();
        }
    }

    protected override Task OnParametersSetAsync() => LadenAsync();

    private async Task LadenAsync()
    {
        _fehler = null;
        try
        {
            _vertrag = await Http.GetFromJsonAsync<VertragDetail>($"api/vertraege/{Id}");
            _bearbeitung.Status = _vertrag!.Status;
            _bearbeitung.Beginn = _vertrag.Beginn;
            _bearbeitung.Mindestlaufzeit = _vertrag.MindestlaufzeitMonate;
            _bearbeitung.Verlaengerung = _vertrag.VerlaengerungMonate;
            _bearbeitung.Kuendigungsfrist = _vertrag.KuendigungsfristMonate;
            _bearbeitung.GekuendigtZum = _vertrag.GekuendigtZum;
            _bearbeitung.Notiz = _vertrag.Notiz;
            foreach (var bestandteil in _vertrag.Bestandteile)
                _dokumentPfade.TryAdd(bestandteil.Id, "");
        }
        catch (Exception ex)
        {
            _fehler = $"Vertrag konnte nicht geladen werden: {ex.Message}";
        }
    }

    private async Task SpeichernAsync()
    {
        _fehler = null;
        _gespeichert = false;
        try
        {
            var antwort = await Http.PutAsJsonAsync($"api/vertraege/{Id}", new VertragAendern(
                _bearbeitung.Status, _bearbeitung.Beginn,
                _bearbeitung.Mindestlaufzeit, _bearbeitung.Verlaengerung, _bearbeitung.Kuendigungsfrist,
                _bearbeitung.GekuendigtZum,
                string.IsNullOrWhiteSpace(_bearbeitung.Notiz) ? null : _bearbeitung.Notiz));
            antwort.EnsureSuccessStatusCode();
            _gespeichert = true;
            await LadenAsync();
        }
        catch (Exception ex)
        {
            _fehler = $"Speichern fehlgeschlagen: {ex.Message}";
        }
    }

    private async Task LoeschenAsync()
    {
        var sicher = await JS.InvokeAsync<bool>("confirm",
            $"Vertrag {_vertrag?.Vertragsnummer} wirklich komplett löschen? " +
            "Bestandteile und Dokument-Registrierungen werden entfernt (nur für Admins; " +
            "Dateien bleiben im Ablageverzeichnis liegen).");
        if (!sicher)
            return;
        _fehler = null;
        try
        {
            var antwort = await Http.DeleteAsync($"api/vertraege/{Id}");
            if (antwort.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _fehler = "Kein Zugriff: Verträge löschen erfordert die Administrator-Rolle.";
                return;
            }
            antwort.EnsureSuccessStatusCode();
            Navigation.NavigateTo("vertraege");
        }
        catch (Exception ex)
        {
            _fehler = $"Löschen fehlgeschlagen: {ex.Message}";
        }
    }

    private async Task BestandteilAnlegenAsync()
    {
        _fehler = null;
        try
        {
            var antwort = await Http.PostAsJsonAsync($"api/vertraege/{Id}/bestandteile", new BestandteilAnlegen(
                _neuerBestandteil.Typ, _neuerBestandteil.Titel ?? "",
                string.IsNullOrWhiteSpace(_neuerBestandteil.Beschreibung) ? null : _neuerBestandteil.Beschreibung,
                _neuerBestandteil.UnterzeichnetAm));
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            _bestandteilOffen = false;
            _neuerBestandteil.Titel = "";
            _neuerBestandteil.Beschreibung = null;
            await LadenAsync();
        }
        catch (Exception ex)
        {
            _fehler = $"Bestandteil konnte nicht angelegt werden: {ex.Message}";
        }
    }

    private async Task DokumentRegistrierenAsync(int bestandteilId)
    {
        _fehler = null;
        var pfad = _dokumentPfade.GetValueOrDefault(bestandteilId, "").Trim();
        if (pfad.Length == 0)
        {
            _fehler = "Bitte den Pfad der Datei relativ zum Vertragsablage-Verzeichnis angeben.";
            return;
        }
        try
        {
            var antwort = await Http.PostAsJsonAsync(
                $"api/vertraege/bestandteile/{bestandteilId}/dokumente", new DokumentRegistrieren(pfad));
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            _dokumentPfade[bestandteilId] = "";
            _versionOffen.Remove(bestandteilId);
            await LadenAsync();
        }
        catch (Exception ex)
        {
            _fehler = $"Dokument konnte nicht registriert werden: {ex.Message}";
        }
    }

    private string? _vorschauUrl;
    private string? _vorschauTitel;

    private async Task VorschauAsync(DokumentEintrag dokument)
    {
        _fehler = null;
        try
        {
            var antwort = await Http.GetAsync($"api/vertraege/dokumente/{dokument.Id}/datei");
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            var bytes = await antwort.Content.ReadAsByteArrayAsync();
            var typ = antwort.Content.Headers.ContentType?.MediaType ?? "application/pdf";
            await VorschauUrlFreigebenAsync();
            _vorschauUrl = await JS.InvokeAsync<string>("dateiVorschau.erzeugeUrl", Convert.ToBase64String(bytes), typ);
            _vorschauTitel = $"{dokument.DateinameOriginal} (v{dokument.Version})";
        }
        catch (Exception ex)
        {
            _fehler = $"Dokument konnte nicht geladen werden: {ex.Message}";
        }
    }

    private async Task VorschauSchliessenAsync()
    {
        await VorschauUrlFreigebenAsync();
        _vorschauTitel = null;
    }

    private async Task VorschauUrlFreigebenAsync()
    {
        if (_vorschauUrl is not null)
        {
            await JS.InvokeVoidAsync("dateiVorschau.freigeben", _vorschauUrl);
            _vorschauUrl = null;
        }
    }

    private static string StatusKlasse(string status) => status switch
    {
        "Aktiv" => "gut",
        "Gekündigt" => "warnung",
        "Beendet" => "kritisch",
        _ => "",
    };

    private class Bearbeitung
    {
        public string Status { get; set; } = "Entwurf";
        public DateOnly Beginn { get; set; }
        public int? Mindestlaufzeit { get; set; }
        public int? Verlaengerung { get; set; }
        public int? Kuendigungsfrist { get; set; }
        public DateOnly? GekuendigtZum { get; set; }
        public string? Notiz { get; set; }
    }

    private class NeuerBestandteil
    {
        public string Typ { get; set; } = "Lizenzvertrag";
        public string? Titel { get; set; }
        public string? Beschreibung { get; set; }
        public DateOnly? UnterzeichnetAm { get; set; }
    }
}
