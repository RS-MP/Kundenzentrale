@page "/vertraege/{Id:int}"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>@(_vertrag?.Vertragsnummer ?? "Vertrag") · Kundenzentrale</PageTitle>

@if (_fehler is not null)
{
    <div class="fehler">@_fehler</div>
}
@if (_vertrag is null)
{
    @if (_fehler is null)
    {
        <div class="leer-hinweis">Lade Vertrag …</div>
    }
}
else
{
    <div class="akte-kopf">
        <div class="seitenkopf">
            @if (_umbenennenOffen)
            {
                <h1>Vertrag @_vertrag.Vertragsnummer</h1>
                <input type="text" maxlength="200" style="min-width:280px" placeholder="Bezeichnung, z. B. Wartungsvertrag ID.prove"
                       @bind="_neueBezeichnung" @bind:event="oninput" @onkeydown="BeiUmbenennenTaste" />
                <button class="knopf" @onclick="UmbenennenAsync">Speichern</button>
                <button class="knopf sekundaer" @onclick="() => _umbenennenOffen = false">Abbrechen</button>
            }
            else
            {
                <h1>
                    Vertrag @_vertrag.Vertragsnummer
                    @if (_vertrag.Bezeichnung is not null)
                    {
                        <span class="vname">@_vertrag.Bezeichnung</span>
                    }
                </h1>
                @if (!_vertrag.GruppeGesperrt)
                {
                    <button class="mehr" title="Bezeichnung des Vertrags ändern — sie steht in allen Listen neben der Nummer"
                            @onclick="UmbenennenOeffnen">@(_vertrag.Bezeichnung is null ? "Benennen" : "Umbenennen")</button>
                }
            }
            <span class="untertitel">
                @if (_vertrag.PartnerId is not null)
                {
                    <a href="partner/@_vertrag.PartnerId">@_vertrag.KundeName</a> <span>· Partnervertrag</span>
                }
                else
                {
                    <a href="kunden/@_vertrag.KundeId">@_vertrag.KundeName</a> <span>· Kunden-Nr. @_vertrag.Kundennummer</span>
                }
            </span>
        </div>
        @if (_vertrag.KundeId is { } hinweisKunde)
        {
            <KundenHinweise KundeId="hinweisKunde" Vorsatz="Zum Kunden" />
        }
        <p class="faktenzeile2">
            @if (_vertrag.Hauptvertrag is { } haupt)
            {
                @* Anhang: Status und Ende gelten vom Hauptvertrag *@
                <span>Anhang zu <a href="vertraege/@haupt.Id">@VerweisKurz(haupt)</a></span>
                <span class="trenn">·</span><span class="status @StatusKlasse(haupt.Status)" title="Status des Hauptvertrags">@haupt.Status</span>
                @if (haupt.NaechstesEnde is not null)
                {
                    <span class="trenn">·</span><span title="Vom Hauptvertrag">Nächstmögliches Ende @haupt.NaechstesEnde.Value.ToString("dd.MM.yyyy")</span>
                }
            }
            else
            {
                <span class="status @StatusKlasse(_vertrag.Status)">@_vertrag.Status</span>
                @if (_vertrag.NaechstesEnde is not null)
                {
                    <span class="trenn">·</span><span>Nächstmögliches Ende @_vertrag.NaechstesEnde.Value.ToString("dd.MM.yyyy")</span>
                }
                else
                {
                    <span class="trenn">·</span><span class="warntext">Laufzeit fehlt — bitte nachpflegen</span>
                }
                @if (_vertrag.Anhaenge.Count > 0)
                {
                    <span class="trenn">·</span><span>@(_vertrag.Anhaenge.Count == 1 ? "1 Anhang" : $"{_vertrag.Anhaenge.Count} Anhänge")</span>
                }
            }
            @if (_vertrag.AktuellerStand is { } stand)
            {
                <span class="trenn">·</span><span title="Jüngstes Dokument der Akte">Stand: @stand.Bezeichnung vom @stand.Datum.ToString("dd.MM.yyyy")</span>
            }
        </p>
    </div>

    <div class="akte">
        <div>
            <div class="karte">
                <div class="karte-kopf">
                    <h2>Bestandteile &amp; Dokumente</h2>
                    <button class="knopf sekundaer" @onclick="() => _bestandteilOffen = !_bestandteilOffen">+ Bestandteil</button>
                </div>
                <div class="karte-koerper">
                    @if (_bestandteilOffen)
                    {
                        <div class="formular" style="margin-bottom:16px">
                            <label>
                                Typ
                                <select @bind="_neuerBestandteil.Typ">
                                    @foreach (var art in Dokumentarten.Namen)
                                    {
                                        <option>@art</option>
                                    }
                                </select>
                            </label>
                            <label>
                                Titel
                                <input type="text" @bind="_neuerBestandteil.Titel" placeholder="z. B. Lizenzvertrag ID prove" />
                            </label>
                            <label>
                                Unterzeichnet am
                                <input type="date" @bind="_neuerBestandteil.UnterzeichnetAm" />
                            </label>
                            <label class="breit">
                                Beschreibung
                                <textarea rows="2" @bind="_neuerBestandteil.Beschreibung"></textarea>
                            </label>
                            @if (_vertrag.DarfVertrauliche)
                            {
                                <label class="breit" style="flex-direction:row; align-items:center; gap:6px">
                                    <input type="checkbox" @bind="_neuerBestandteil.Vertraulich" />
                                    Vertraulich — Titel, Beschreibung und Dokumente nur für die Rolle „Vertrauliche Verträge"
                                </label>
                            }
                            <label class="breit">
                                Kurzinfo für alle (optional)
                                <input type="text" maxlength="300" @bind="_neuerBestandteil.Kurzinfo"
                                       placeholder="z. B. Sonderpreis 10 % auf Wartung bis 2027 · Provision 15 %" />
                            </label>
                            <div class="formular-aktionen breit">
                                <button class="knopf" @onclick="BestandteilAnlegenAsync">Hinzufügen</button>
                            </div>
                        </div>
                    }

                    @if (_vertrag.Bestandteile.Count == 0)
                    {
                        <div class="leer-hinweis">
                            Noch keine Bestandteile — typischer Abschluss: Lizenzvertrag inkl. AVV,
                            optional NDA und Sondervereinbarungen.
                        </div>
                    }
                    @{ var mehrereArten = _vertrag.Bestandteile.Where(b => b.GehoertZuId is null).Select(b => b.Typ).Distinct().Count() > 1; string? letzteArt = null; }
                    @foreach (var bestandteil in _vertrag.Bestandteile)
                    {
                        @* Gruppiert nach Dokumentart (API-Reihenfolge), innerhalb neuestes oben;
                           Anlagen stehen eingerückt direkt unter ihrem Hauptdokument *@
                        var istAnlage = bestandteil.GehoertZuId is not null;
                        @if (mehrereArten && !istAnlage && bestandteil.Typ != letzteArt)
                        {
                            <div class="dokart-gruppe">@Dokumentarten.Mehrzahl(bestandteil.Typ)</div>
                        }
                        if (!istAnlage)
                        {
                            letzteArt = bestandteil.Typ;
                        }
                        <div class="@(istAnlage ? "banlage" : "")" style="margin-bottom:18px">
                            @* Einheitlich: Kürzel + Typ (ggf. mit laufender Nummer) fett, Titel dezent dahinter *@
                            <div style="display:flex; align-items:baseline; gap:8px; flex-wrap:wrap">
                                @if (istAnlage)
                                {
                                    <span class="vanhang-pfeil" title="Anlage zum Dokument darüber">↳ Anlage</span>
                                }
                                <span class="typ" title="@bestandteil.Typ">@bestandteil.Kuerzel</span>
                                <strong>@bestandteil.Typ@(bestandteil.LaufendeNummer is { } nr ? $" {nr}" : "")</strong>
                                @if (!bestandteil.Gesperrt && !string.Equals(bestandteil.Titel, bestandteil.Typ, StringComparison.OrdinalIgnoreCase))
                                {
                                    <span style="color:var(--ink2)">@bestandteil.Titel</span>
                                }
                                @if (bestandteil.UnterzeichnetAm is not null)
                                {
                                    <span style="color:var(--muted)">unterzeichnet @bestandteil.UnterzeichnetAm.Value.ToString("dd.MM.yyyy")</span>
                                }
                                else if (bestandteil.Dokumentdatum is not null)
                                {
                                    <span style="color:var(--muted)" title="@Dokumentarten.QuelleHinweis(bestandteil.DokumentdatumQuelle)">
                                        @(bestandteil.DokumentdatumQuelle == "Dateidatum" ? "ca. " : "")@bestandteil.Dokumentdatum.Value.ToString("dd.MM.yyyy")
                                    </span>
                                }
                                @if (bestandteil.IstAktuellster && _vertrag.Bestandteile.Count > 1)
                                {
                                    <span class="stand-neu">· jüngstes Dokument</span>
                                }
                                @if (bestandteil.Vertraulich)
                                {
                                    <span class="pill" title="Vertraulich — vollständig nur für die Rolle „Vertrauliche Verträge“">🔒 vertraulich</span>
                                }
                                @if (!bestandteil.Gesperrt)
                                {
                                    <button class="mehr" style="margin-left:auto" @onclick="() => BearbeitenOeffnen(bestandteil)"
                                            title="Titel, Dokumentart, Datum und Kurzinfo dieses Dokuments ändern oder es als Anlage einem anderen Dokument zuordnen">Umbenennen · Zuordnen</button>
                                }
                            </div>
                            @if (bestandteil.Kurzinfo is not null)
                            {
                                <div style="color:var(--ink2); margin:4px 0">@bestandteil.Kurzinfo</div>
                            }
                            @if (bestandteil.Gesperrt)
                            {
                                <div style="color:var(--muted); font-size:12.5px; margin:2px 0">
                                    Inhalt und Dokumente sind vertraulich — Einsicht über die Rolle „Vertrauliche Verträge"
                                    (bei Bedarf bitte an Compliance/Geschäftsführung wenden).
                                </div>
                            }
                            @if (_bearbeiteterBestandteil?.Id == bestandteil.Id)
                            {
                                <div class="formular" style="margin:10px 0 12px">
                                    <label>
                                        Dokumentart
                                        <select @bind="_bestandteilAenderung.Typ">
                                            @foreach (var art in Dokumentarten.Namen)
                                            {
                                                <option>@art</option>
                                            }
                                        </select>
                                    </label>
                                    <label>Titel<input type="text" @bind="_bestandteilAenderung.Titel" /></label>
                                    <label>
                                        Dokumentdatum
                                        <input type="date" @bind="_bestandteilAenderung.Dokumentdatum" />
                                    </label>
                                    <label>
                                        Unterzeichnet am
                                        <input type="date" @bind="_bestandteilAenderung.UnterzeichnetAm" />
                                    </label>
                                    <label class="breit">Beschreibung<textarea rows="2" @bind="_bestandteilAenderung.Beschreibung"></textarea></label>
                                    <label class="breit">
                                        Kurzinfo für alle
                                        <input type="text" maxlength="300" @bind="_bestandteilAenderung.Kurzinfo" />
                                    </label>
                                    @* Dokumente gruppieren: Anlage zu einem anderen Dokument dieser Akte *@
                                    @if (_vertrag.Bestandteile.Any(b => b.GehoertZuId == bestandteil.Id))
                                    {
                                        <div class="vgruppe-hinweis breit">
                                            Diesem Dokument sind Anlagen zugeordnet — es kann deshalb nicht selbst Anlage sein.
                                        </div>
                                    }
                                    else if (MoeglicheHauptdokumente(bestandteil).Count > 0 || _bestandteilAenderung.GehoertZuId != 0)
                                    {
                                        <label class="breit">
                                            Anlage zu
                                            <select @bind="_bestandteilAenderung.GehoertZuId">
                                                <option value="0">— eigenständiges Dokument —</option>
                                                @foreach (var anderes in MoeglicheHauptdokumente(bestandteil))
                                                {
                                                    <option value="@anderes.Id">@DokumentText(anderes)</option>
                                                }
                                            </select>
                                        </label>
                                    }
                                    @if (_vertrag.DarfVertrauliche)
                                    {
                                        <label class="breit" style="flex-direction:row; align-items:center; gap:6px">
                                            <input type="checkbox" @bind="_bestandteilAenderung.Vertraulich" />
                                            Vertraulich
                                        </label>
                                    }
                                    <div class="formular-aktionen breit">
                                        <button class="knopf" @onclick="BestandteilSpeichernAsync">Speichern</button>
                                        <button class="knopf sekundaer" @onclick="() => _bearbeiteterBestandteil = null">Abbrechen</button>
                                        <span style="color:var(--muted); font-size:12px">
                                            Reihenfolge: „Unterzeichnet am" vor Dokumentdatum; ein hier gesetztes Datum überschreibt die automatische Erkennung.
                                        </span>
                                    </div>
                                </div>
                            }
                            @if (bestandteil.Beschreibung is not null)
                            {
                                <div style="color:var(--ink2); margin:4px 0">@bestandteil.Beschreibung</div>
                            }
                            @foreach (var dokument in bestandteil.Dokumente)
                            {
                                <div class="dokument">
                                    <span class="pill">v@(dokument.Version)</span>
                                    <span class="pfad" title="@dokument.Dateipfad">@dokument.DateinameOriginal
                                        <span style="color:var(--muted)"> — @Ordner(dokument.Dateipfad)@(dokument.VorlagenStand is not null ? $" · aus {dokument.VorlagenStand}" : "")</span>
                                    </span>
                                    <span class="hash" title="SHA-256: @dokument.Sha256">@dokument.Sha256[..12]…</span>
                                    <button class="knopf sekundaer" @onclick="() => VorschauAsync(dokument)">Ansehen</button>
                                    @if (dokument.OrdnerPfad is not null)
                                    {
                                        <a class="knopf sekundaer" href="@OrdnerLink(dokument.OrdnerPfad)"
                                           title="@dokument.OrdnerPfad — öffnet den Ablage-Ordner im Explorer (falls nichts passiert: Intranet-Dateilinks im Browser freischalten oder „Pfad" nutzen)">Ordner</a>
                                        <button class="knopf sekundaer" @onclick="() => PfadKopierenAsync(dokument)"
                                                title="Vollständigen Dateipfad kopieren — in der Explorer-Adresszeile einfügen öffnet die Datei direkt">
                                            @(_pfadKopiertId == dokument.Id ? "✓ kopiert" : "Pfad")
                                        </button>
                                    }
                                </div>
                            }
                            @if (_versionOffen.Contains(bestandteil.Id))
                            {
                                <div style="display:flex; gap:8px; margin-top:8px">
                                    <input type="text" style="flex:1; font-family:Consolas,monospace; font-size:13px"
                                           placeholder="@(bestandteil.Vertraulich
                                               ? "Pfad relativ zur vertraulichen Ablage, z. B. Partner\\CSB Vertriebsvertrag.pdf"
                                               : "Pfad relativ zum Ablageverzeichnis, z. B. 2_Wartungsverträge\\4228-2.pdf")"
                                           @bind="_dokumentPfade[bestandteil.Id]" />
                                    <button class="knopf" @onclick="() => DokumentRegistrierenAsync(bestandteil.Id)">Registrieren</button>
                                    <button class="knopf sekundaer" @onclick="() => _versionOffen.Remove(bestandteil.Id)">Abbrechen</button>
                                </div>
                            }
                            else if (!bestandteil.Gesperrt)
                            {
                                <button class="mehr" @onclick="() => _versionOffen.Add(bestandteil.Id)">+ Version hinzufügen</button>
                            }
                        </div>
                    }
                    <div style="color:var(--muted); font-size:12px; margin-top:8px">
                        Dokumente bleiben im Ablageverzeichnis (Administration → Vertragsablage.Verzeichnis).
                        Die Kundenzentrale speichert Pfad + SHA-256-Prüfsumme; Versionen sind unveränderlich.
                    </div>
                </div>
            </div>
        </div>

        <div>
            <div class="karte">
                <div class="karte-kopf"><h2>Stammdaten</h2></div>
                <div class="karte-koerper">
                    @if (_vertrag.Hauptvertrag is { } hauptvertrag)
                    {
                        <div class="vgruppe-hinweis" style="margin-top:0">
                            Dieser Vertrag ist ein Anhang. Status, Laufzeit und Kündigung gelten vom Hauptvertrag
                            <a href="vertraege/@hauptvertrag.Id">@hauptvertrag.Vertragsnummer</a> und werden dort gepflegt.
                        </div>
                    }
                    <div class="formular">
                        @if (_vertrag.Hauptvertrag is null)
                        {
                        <label>
                            Status
                            <select @bind="_bearbeitung.Status">
                                <option>Entwurf</option>
                                <option>Aktiv</option>
                                <option>Gekündigt</option>
                                <option>Beendet</option>
                            </select>
                        </label>
                        <label>
                            Beginn
                            <input type="date" @bind="_bearbeitung.Beginn" />
                        </label>
                        <label>
                            Mindestlaufzeit (Monate)
                            <input type="number" @bind="_bearbeitung.Mindestlaufzeit" min="0" />
                        </label>
                        <label>
                            Verlängerung (Monate)
                            <input type="number" @bind="_bearbeitung.Verlaengerung" min="0" />
                        </label>
                        <label>
                            Kündigungsfrist (Monate)
                            <input type="number" @bind="_bearbeitung.Kuendigungsfrist" min="0" />
                        </label>
                        <label>
                            Gekündigt zum
                            <input type="date" @bind="_bearbeitung.GekuendigtZum" />
                        </label>
                        }
                        <label class="breit">
                            Notiz
                            <textarea rows="3" @bind="_bearbeitung.Notiz"></textarea>
                        </label>
                    </div>
                    <div class="formular-aktionen">
                        <button class="knopf" @onclick="SpeichernAsync">Speichern</button>
                        @if (_gespeichert)
                        {
                            <span style="color:var(--good)">✓ gespeichert</span>
                        }
                        <span style="flex:1"></span>
                        <button class="knopf sekundaer krittext" @onclick="LoeschenAsync">Vertrag löschen …</button>
                    </div>
                </div>
            </div>

            @* Zusammenfassen (11/2026): Hauptvertrag mit Anhängen — gruppiert wird nur die Anzeige,
               jeder Vertrag behält Nummer und Dokumente *@
            <div class="karte" style="margin-top:16px">
                <div class="karte-kopf"><h2>Hauptvertrag &amp; Anhänge</h2></div>
                <div class="karte-koerper">
                    @if (_vertrag.Hauptvertrag is { } zugeordnet)
                    {
                        <div>
                            Anhang zu <a href="vertraege/@zugeordnet.Id" style="font-weight:600">@zugeordnet.Vertragsnummer</a>
                            @if (zugeordnet.Bezeichnung is not null)
                            {
                                <span class="vname">@zugeordnet.Bezeichnung</span>
                            }
                        </div>
                        @if (!_vertrag.GruppeGesperrt)
                        {
                            <div class="formular-aktionen">
                                <button class="knopf sekundaer" @onclick="() => ZuordnenAsync(_vertrag.Id, null)">Zuordnung lösen</button>
                            </div>
                            <div class="vgruppe-hinweis">
                                Nach dem Lösen steht der Vertrag wieder für sich — mit seinem eigenen Status und seiner eigenen Laufzeit.
                            </div>
                        }
                    }
                    else
                    {
                        @if (_vertrag.Anhaenge.Count > 0)
                        {
                            @if (_vertrag.GruppeGesperrt)
                            {
                                <VertragAnhaenge Anhaenge="_vertrag.Anhaenge" />
                            }
                            else
                            {
                                <VertragAnhaenge Anhaenge="_vertrag.Anhaenge" BeiLoesen="a => ZuordnenAsync(a.Id, null)" />
                            }
                        }
                        else
                        {
                            <div class="vgruppe-hinweis" style="margin-top:0">
                                Gehören mehrere Verträge zusammen, lassen sie sich hier zusammenfassen: Anhänge stehen dann
                                in allen Listen eingerückt unter ihrem Hauptvertrag.
                            </div>
                        }
                        @if (_vertrag.GruppeGesperrt)
                        {
                            <div class="vgruppe-hinweis">
                                Vertraulicher Vertrag — Umbenennen und Zuordnen nur mit der Rolle „Vertrauliche Verträge“.
                            </div>
                        }
                        else if (_vertrag.AndereVertraege.Count == 0)
                        {
                            <div class="vgruppe-hinweis">Es gibt keine weiteren Verträge mit dieser Vertragspartei.</div>
                        }
                        else
                        {
                            @if (MoeglicheAnhaenge.Count > 0)
                            {
                                <div class="formular" style="margin-top:12px">
                                    <label class="breit">
                                        Anhang hinzufügen
                                        <select @bind="_neuerAnhangId">
                                            <option value="0">— Vertrag wählen —</option>
                                            @foreach (var anderer in MoeglicheAnhaenge)
                                            {
                                                <option value="@anderer.Id">@VerweisText(anderer)</option>
                                            }
                                        </select>
                                    </label>
                                </div>
                                <div class="formular-aktionen">
                                    <button class="knopf sekundaer" disabled="@(_neuerAnhangId == 0)"
                                            @onclick="() => ZuordnenAsync(_neuerAnhangId, _vertrag.Id)">Als Anhang hinzufügen</button>
                                </div>
                            }
                            @if (_vertrag.Anhaenge.Count == 0 && MoeglicheHauptvertraege.Count > 0)
                            {
                                <div class="formular" style="margin-top:12px">
                                    <label class="breit">
                                        Oder: diesen Vertrag als Anhang zuordnen zu
                                        <select @bind="_neuerHauptvertragId">
                                            <option value="0">— Hauptvertrag wählen —</option>
                                            @foreach (var anderer in MoeglicheHauptvertraege)
                                            {
                                                <option value="@anderer.Id">@VerweisText(anderer)</option>
                                            }
                                        </select>
                                    </label>
                                </div>
                                <div class="formular-aktionen">
                                    <button class="knopf sekundaer" disabled="@(_neuerHauptvertragId == 0)"
                                            @onclick="() => ZuordnenAsync(_vertrag.Id, _neuerHauptvertragId)">Zuordnen</button>
                                </div>
                            }
                            <div class="vgruppe-hinweis">
                                Für Anhänge gelten Status, Laufzeit und Kündigung des Hauptvertrags. Jeder Vertrag behält
                                seine Nummer und seine Dokumente; die Zuordnung lässt sich jederzeit wieder lösen.
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_vorschauUrl is not null)
{
    <div class="vorschau-overlay" @onclick="VorschauSchliessenAsync">
        <div class="vorschau-fenster" @onclick:stopPropagation="true">
            <div class="vorschau-kopf">
                <span class="titel">@_vorschauTitel</span>
                <a class="knopf sekundaer" href="@_vorschauUrl" target="_blank">In neuem Tab öffnen</a>
                <button class="knopf" @onclick="VorschauSchliessenAsync">Schließen</button>
            </div>
            <iframe src="@_vorschauUrl" title="Dokumentvorschau"></iframe>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private VertragDetail? _vertrag;
    private string? _fehler;
    private bool _gespeichert;
    private bool _bestandteilOffen;
    private readonly Bearbeitung _bearbeitung = new();
    private readonly NeuerBestandteil _neuerBestandteil = new();
    private readonly Dictionary<int, string> _dokumentPfade = [];
    private readonly HashSet<int> _versionOffen = [];

    /// <summary>Übergeordneter Ordner der Datei — unterscheidet gleichnamige Dateien aus verschiedenen Ablage-Ordnern.</summary>
    private static string Ordner(string pfad)
    {
        var teile = pfad.Split('\\', StringSplitOptions.RemoveEmptyEntries);
        return teile.Length >= 2 ? teile[^2] : "";
    }

    private int? _pfadKopiertId;

    // UNC-Ordner als file://-Link (öffnet den Explorer; braucht im Browser
    // freigeschaltete Intranet-Dateilinks, sonst greift „Pfad kopieren")
    private static string OrdnerLink(string ordner)
    {
        try { return new Uri(ordner).AbsoluteUri; }
        catch { return ""; }
    }

    private async Task PfadKopierenAsync(DokumentEintrag dokument)
    {
        var dateiname = dokument.Dateipfad.Split('\\', StringSplitOptions.RemoveEmptyEntries)[^1];
        var voll = $"{dokument.OrdnerPfad}\\{dateiname}";
        if (await JS.InvokeAsync<bool>("zwischenablage.kopieren", voll))
        {
            _pfadKopiertId = dokument.Id;
            _ = EntferneKopiertMarkierungAsync(dokument.Id);
        }
        else
        {
            await JS.InvokeVoidAsync("zwischenablage.anzeigen", voll);
        }
    }

    private async Task EntferneKopiertMarkierungAsync(int dokumentId)
    {
        await Task.Delay(2500);
        if (_pfadKopiertId == dokumentId)
        {
            _pfadKopiertId = null;
            StateHasChanged();
        }
    }

    protected override Task OnParametersSetAsync() => LadenAsync();

    private async Task LadenAsync()
    {
        _fehler = null;
        try
        {
            _vertrag = await Http.GetFromJsonAsync<VertragDetail>($"api/vertraege/{Id}");
            _bearbeitung.Status = _vertrag!.Status;
            _bearbeitung.Beginn = _vertrag.Beginn;
            _bearbeitung.Mindestlaufzeit = _vertrag.MindestlaufzeitMonate;
            _bearbeitung.Verlaengerung = _vertrag.VerlaengerungMonate;
            _bearbeitung.Kuendigungsfrist = _vertrag.KuendigungsfristMonate;
            _bearbeitung.GekuendigtZum = _vertrag.GekuendigtZum;
            _bearbeitung.Notiz = _vertrag.Notiz;
            // Partnerverträge sind in der Regel vertraulich — Vorbelegung für neue Bestandteile
            if (_vertrag.PartnerId is not null && _vertrag.DarfVertrauliche && !_bestandteilOffen)
                _neuerBestandteil.Vertraulich = true;
            foreach (var bestandteil in _vertrag.Bestandteile)
                _dokumentPfade.TryAdd(bestandteil.Id, "");
        }
        catch (Exception ex)
        {
            _fehler = $"Vertrag konnte nicht geladen werden: {ex.Message}";
        }
    }

    private async Task SpeichernAsync()
    {
        _fehler = null;
        _gespeichert = false;
        try
        {
            var antwort = await Http.PutAsJsonAsync($"api/vertraege/{Id}", new VertragAendern(
                _bearbeitung.Status, _bearbeitung.Beginn,
                _bearbeitung.Mindestlaufzeit, _bearbeitung.Verlaengerung, _bearbeitung.Kuendigungsfrist,
                _bearbeitung.GekuendigtZum,
                string.IsNullOrWhiteSpace(_bearbeitung.Notiz) ? null : _bearbeitung.Notiz));
            antwort.EnsureSuccessStatusCode();
            _gespeichert = true;
            await LadenAsync();
        }
        catch (Exception ex)
        {
            _fehler = $"Speichern fehlgeschlagen: {ex.Message}";
        }
    }

    // --- Umbenennen und Zusammenfassen (11/2026) ------------------------------

    private bool _umbenennenOffen;
    private string? _neueBezeichnung;
    private int _neuerAnhangId;
    private int _neuerHauptvertragId;

    /// <summary>Als Anhang kommen Verträge in Frage, die für sich stehen: kein Anhang, keine eigenen Anhänge.</summary>
    private List<VertragVerweis> MoeglicheAnhaenge =>
        _vertrag!.AndereVertraege.Where(v => !v.IstAnhang && !v.HatAnhaenge).ToList();

    /// <summary>Als Hauptvertrag kommt jeder Vertrag in Frage, der nicht selbst Anhang ist.</summary>
    private List<VertragVerweis> MoeglicheHauptvertraege =>
        _vertrag!.AndereVertraege.Where(v => !v.IstAnhang).ToList();

    private static string VerweisText(VertragVerweis vertrag) =>
        $"{vertrag.Vertragsnummer}{(vertrag.Bezeichnung is null ? "" : " · " + vertrag.Bezeichnung)} ({vertrag.Status})";

    private static string VerweisKurz(VertragVerweis vertrag) =>
        vertrag.Bezeichnung is null ? vertrag.Vertragsnummer : $"{vertrag.Vertragsnummer} {vertrag.Bezeichnung}";

    private void UmbenennenOeffnen()
    {
        _neueBezeichnung = _vertrag?.Bezeichnung;
        _umbenennenOffen = true;
    }

    private Task BeiUmbenennenTaste(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            return UmbenennenAsync();
        if (e.Key == "Escape")
            _umbenennenOffen = false;
        return Task.CompletedTask;
    }

    private async Task UmbenennenAsync()
    {
        _fehler = null;
        try
        {
            var antwort = await Http.PutAsJsonAsync($"api/vertraege/{Id}/bezeichnung",
                new VertragUmbenennen(string.IsNullOrWhiteSpace(_neueBezeichnung) ? null : _neueBezeichnung));
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            _umbenennenOffen = false;
            await LadenAsync();
        }
        catch (Exception ex)
        {
            _fehler = $"Umbenennen fehlgeschlagen: {ex.Message}";
        }
    }

    /// <summary>Ordnet <paramref name="anhangId"/> dem Hauptvertrag zu — oder löst die Zuordnung (null).</summary>
    private async Task ZuordnenAsync(int anhangId, int? hauptvertragId)
    {
        if (anhangId == 0 || hauptvertragId == 0)
            return;
        _fehler = null;
        try
        {
            var antwort = await Http.PutAsJsonAsync($"api/vertraege/{anhangId}/hauptvertrag",
                new VertragZuordnen(hauptvertragId));
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            _neuerAnhangId = 0;
            _neuerHauptvertragId = 0;
            await LadenAsync();
        }
        catch (Exception ex)
        {
            _fehler = $"Zuordnung fehlgeschlagen: {ex.Message}";
        }
    }

    private async Task LoeschenAsync()
    {
        var sicher = await JS.InvokeAsync<bool>("confirm",
            $"Vertrag {_vertrag?.Vertragsnummer} wirklich komplett löschen? " +
            "Bestandteile und Dokument-Registrierungen werden entfernt (nur für Admins; " +
            "Dateien bleiben im Ablageverzeichnis liegen).");
        if (!sicher)
            return;
        _fehler = null;
        try
        {
            var antwort = await Http.DeleteAsync($"api/vertraege/{Id}");
            if (antwort.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                _fehler = "Kein Zugriff: Verträge löschen erfordert die Administrator-Rolle.";
                return;
            }
            antwort.EnsureSuccessStatusCode();
            Navigation.NavigateTo("vertraege");
        }
        catch (Exception ex)
        {
            _fehler = $"Löschen fehlgeschlagen: {ex.Message}";
        }
    }

    private async Task BestandteilAnlegenAsync()
    {
        _fehler = null;
        try
        {
            var antwort = await Http.PostAsJsonAsync($"api/vertraege/{Id}/bestandteile", new BestandteilAnlegen(
                _neuerBestandteil.Typ, _neuerBestandteil.Titel ?? "",
                string.IsNullOrWhiteSpace(_neuerBestandteil.Beschreibung) ? null : _neuerBestandteil.Beschreibung,
                _neuerBestandteil.UnterzeichnetAm,
                _neuerBestandteil.Vertraulich,
                string.IsNullOrWhiteSpace(_neuerBestandteil.Kurzinfo) ? null : _neuerBestandteil.Kurzinfo));
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            _bestandteilOffen = false;
            _neuerBestandteil.Titel = "";
            _neuerBestandteil.Beschreibung = null;
            _neuerBestandteil.Kurzinfo = null;
            _neuerBestandteil.Vertraulich = false;
            await LadenAsync();
        }
        catch (Exception ex)
        {
            _fehler = $"Bestandteil konnte nicht angelegt werden: {ex.Message}";
        }
    }

    private BestandteilDetail? _bearbeiteterBestandteil;
    private readonly NeuerBestandteil _bestandteilAenderung = new();

    private void BearbeitenOeffnen(BestandteilDetail bestandteil)
    {
        _bearbeiteterBestandteil = bestandteil;
        _bestandteilAenderung.Typ = bestandteil.Typ;
        _bestandteilAenderung.Titel = bestandteil.Titel;
        _bestandteilAenderung.Beschreibung = bestandteil.Beschreibung;
        _bestandteilAenderung.UnterzeichnetAm = bestandteil.UnterzeichnetAm;
        _bestandteilAenderung.Dokumentdatum = bestandteil.Dokumentdatum;
        _bestandteilAenderung.Vertraulich = bestandteil.Vertraulich;
        _bestandteilAenderung.Kurzinfo = bestandteil.Kurzinfo;
        _bestandteilAenderung.GehoertZuId = bestandteil.GehoertZuId ?? 0;
    }

    /// <summary>
    /// Als Hauptdokument kommen die übrigen eigenständigen Dokumente der Akte in Frage —
    /// keine Anlagen (genau eine Ebene) und nichts, was für den Benutzer gesperrt ist.
    /// </summary>
    private List<BestandteilDetail> MoeglicheHauptdokumente(BestandteilDetail bestandteil) =>
        _vertrag!.Bestandteile
            .Where(b => b.Id != bestandteil.Id && b.GehoertZuId is null && !b.Gesperrt)
            .ToList();

    private static string DokumentText(BestandteilDetail b)
    {
        var art = b.LaufendeNummer is { } nr ? $"{b.Typ} {nr}" : b.Typ;
        var titel = string.Equals(b.Titel, b.Typ, StringComparison.OrdinalIgnoreCase) ? "" : $" · {b.Titel}";
        var datum = (b.UnterzeichnetAm ?? b.Dokumentdatum) is { } d ? $" ({d:dd.MM.yyyy})" : "";
        return art + titel + datum;
    }

    private async Task BestandteilSpeichernAsync()
    {
        if (_bearbeiteterBestandteil is null)
            return;
        _fehler = null;
        try
        {
            var antwort = await Http.PutAsJsonAsync($"api/vertraege/bestandteile/{_bearbeiteterBestandteil.Id}",
                new BestandteilAendern(
                    _bestandteilAenderung.Typ, _bestandteilAenderung.Titel ?? "",
                    string.IsNullOrWhiteSpace(_bestandteilAenderung.Beschreibung) ? null : _bestandteilAenderung.Beschreibung,
                    _bestandteilAenderung.UnterzeichnetAm, _bestandteilAenderung.Dokumentdatum,
                    _bestandteilAenderung.Vertraulich,
                    string.IsNullOrWhiteSpace(_bestandteilAenderung.Kurzinfo) ? null : _bestandteilAenderung.Kurzinfo));
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            // Zuordnung als Anlage nur schicken, wenn sie sich geändert hat (0 = eigenständig)
            int? gehoertZu = _bestandteilAenderung.GehoertZuId == 0 ? null : _bestandteilAenderung.GehoertZuId;
            if (gehoertZu != _bearbeiteterBestandteil.GehoertZuId)
            {
                var zuordnung = await Http.PutAsJsonAsync(
                    $"api/vertraege/bestandteile/{_bearbeiteterBestandteil.Id}/gehoert-zu",
                    new BestandteilZuordnen(gehoertZu));
                if (!zuordnung.IsSuccessStatusCode)
                {
                    _fehler = await zuordnung.Content.ReadAsStringAsync();
                    await LadenAsync();
                    return;
                }
            }
            _bearbeiteterBestandteil = null;
            await LadenAsync();
        }
        catch (Exception ex)
        {
            _fehler = $"Bestandteil konnte nicht gespeichert werden: {ex.Message}";
        }
    }

    private async Task DokumentRegistrierenAsync(int bestandteilId)
    {
        _fehler = null;
        var pfad = _dokumentPfade.GetValueOrDefault(bestandteilId, "").Trim();
        if (pfad.Length == 0)
        {
            _fehler = "Bitte den Pfad der Datei relativ zum Vertragsablage-Verzeichnis angeben.";
            return;
        }
        try
        {
            var antwort = await Http.PostAsJsonAsync(
                $"api/vertraege/bestandteile/{bestandteilId}/dokumente", new DokumentRegistrieren(pfad));
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            _dokumentPfade[bestandteilId] = "";
            _versionOffen.Remove(bestandteilId);
            await LadenAsync();
        }
        catch (Exception ex)
        {
            _fehler = $"Dokument konnte nicht registriert werden: {ex.Message}";
        }
    }

    private string? _vorschauUrl;
    private string? _vorschauTitel;

    private async Task VorschauAsync(DokumentEintrag dokument)
    {
        _fehler = null;
        try
        {
            var antwort = await Http.GetAsync($"api/vertraege/dokumente/{dokument.Id}/datei");
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            var bytes = await antwort.Content.ReadAsByteArrayAsync();
            var typ = antwort.Content.Headers.ContentType?.MediaType ?? "application/pdf";
            await VorschauUrlFreigebenAsync();
            _vorschauUrl = await JS.InvokeAsync<string>("dateiVorschau.erzeugeUrl", Convert.ToBase64String(bytes), typ);
            _vorschauTitel = $"{dokument.DateinameOriginal} (v{dokument.Version})";
        }
        catch (Exception ex)
        {
            _fehler = $"Dokument konnte nicht geladen werden: {ex.Message}";
        }
    }

    private async Task VorschauSchliessenAsync()
    {
        await VorschauUrlFreigebenAsync();
        _vorschauTitel = null;
    }

    private async Task VorschauUrlFreigebenAsync()
    {
        if (_vorschauUrl is not null)
        {
            await JS.InvokeVoidAsync("dateiVorschau.freigeben", _vorschauUrl);
            _vorschauUrl = null;
        }
    }

    private static string StatusKlasse(string status) => status switch
    {
        "Aktiv" => "gut",
        "Gekündigt" => "warnung",
        "Beendet" => "kritisch",
        _ => "",
    };

    private class Bearbeitung
    {
        public string Status { get; set; } = "Entwurf";
        public DateOnly Beginn { get; set; }
        public int? Mindestlaufzeit { get; set; }
        public int? Verlaengerung { get; set; }
        public int? Kuendigungsfrist { get; set; }
        public DateOnly? GekuendigtZum { get; set; }
        public string? Notiz { get; set; }
    }

    private class NeuerBestandteil
    {
        public string Typ { get; set; } = "Lizenzvertrag";
        public string? Titel { get; set; }
        public string? Beschreibung { get; set; }
        public DateOnly? UnterzeichnetAm { get; set; }
        public DateOnly? Dokumentdatum { get; set; }
        public bool Vertraulich { get; set; }
        public string? Kurzinfo { get; set; }
        /// <summary>Anlage zu diesem Bestandteil; 0 = eigenständiges Dokument.</summary>
        public int GehoertZuId { get; set; }
    }
}
