@page "/wiki/preisliste"
@inject HttpClient Http

<PageTitle>Preisliste · Wiki · Kundenzentrale</PageTitle>

<div class="seitenkopf">
    <h1>Preisliste</h1>
    <span class="untertitel"><a href="wiki">Wiki</a> · ID.prove SaaS — Stand aus dem Preislisten-Projekt</span>
</div>

@if (_fehler is not null)
{
    <div class="fehler">@_fehler</div>
}

@if (_ansicht is null)
{
    @if (_fehler is null)
    {
        <div class="leer-hinweis">Lade Preisliste …</div>
    }
}
else
{
    @* ---------- Versionskarte ---------- *@
    <div class="karte" style="margin-bottom:16px">
        <div class="karte-koerper">
            @if (_ansicht.Version is null)
            {
                <div class="leer-hinweis">
                    Noch keine Preisliste importiert. Das Preislisten-Projekt legt je Version eine JSON-Datei im
                    Preislisten-Ordner ab — ein Wiki-Redakteur importiert sie hier.
                </div>
            }
            else
            {
                <div style="display:flex; gap:14px; align-items:baseline; flex-wrap:wrap">
                    <span style="font-size:15px"><b>Version @_ansicht.Version.Version</b> · Stand @StandText(_ansicht.Version.Stand)</span>
                    @if (_ansicht.Version.GueltigAb is { } ab)
                    {
                        <span class="neben" style="display:inline">gültig ab @ab.ToString("dd.MM.yyyy")</span>
                    }
                    @if (_ansicht.Historie.FirstOrDefault()?.Version != _ansicht.Version.Version)
                    {
                        <span class="pill warntext">ältere Version — aktuell ist v@(_ansicht.Historie[0].Version)</span>
                    }
                    <span style="flex:1"></span>
                    <span class="neben" style="display:inline">
                        importiert @_ansicht.Version.ImportiertAm.ToLocalTime().ToString("dd.MM.yyyy HH:mm")@(_ansicht.Version.ImportiertVon is not null ? $" von {_ansicht.Version.ImportiertVon}" : "")
                    </span>
                </div>
                <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:10px">
                    @if (_ansicht.Version.DateiExtern is not null)
                    {
                        <span class="pill" title="Kundenfassung">extern: @_ansicht.Version.DateiExtern</span>
                    }
                    @if (_ansicht.Version.DateiIntern is not null)
                    {
                        <span class="pill" title="Interne Vertriebsfassung — nur Vertrieb/Admin/Compliance">intern: @_ansicht.Version.DateiIntern</span>
                    }
                    @if (_ansicht.Verzeichnis is not null)
                    {
                        <a class="knopf sekundaer klein" href="@OrdnerLink(_ansicht.Verzeichnis)"
                           title="@_ansicht.Verzeichnis — öffnet den Preislisten-Ordner im Explorer">Ordner öffnen</a>
                    }
                    @if (_ansicht.Daten?.Konditionen is not null)
                    {
                        <span class="neben" style="display:inline">@_ansicht.Daten.Konditionen</span>
                    }
                </div>
            }
            @if (_ansicht.DarfBearbeiten)
            {
                <div style="border-top:1px dashed var(--border); margin-top:12px; padding-top:10px; display:flex; gap:10px; align-items:center; flex-wrap:wrap">
                    <span style="font-size:13px; color:var(--ink2)">Neue Version importieren (JSON-Export):</span>
                    <InputFile OnChange="DateiGewaehlt" accept=".json" />
                    <input type="text" style="min-width:220px" placeholder="Notiz (optional)" @bind="_importNotiz" />
                    <button class="knopf" disabled="@(_importDatei is null || _importiere)" @onclick="ImportierenAsync">
                        @(_importiere ? "Importiere …" : "Importieren")
                    </button>
                    @if (_ansicht.Daten is not null && !_anordnen)
                    {
                        <span style="flex:1"></span>
                        <button class="knopf sekundaer klein" @onclick="AnordnenOeffnen" title="Reihenfolge der Abschnitte auf dieser Seite festlegen — gilt für alle Leser">Abschnitte anordnen</button>
                    }
                </div>
            }
        </div>
    </div>

    @if (_ansicht.Daten is { } p)
    {
        var vorhanden = StandardAbschnitte.Where(a => Abschnitt(a.Schluessel, p) is not null).Select(a => a.Schluessel).ToHashSet();

        @* ---------- Abschnitte anordnen (Wiki-Redaktion) ---------- *@
        @if (_anordnen)
        {
            <div class="karte pl-anordnen" style="margin-bottom:16px">
                <div class="karte-koerper">
                    <div style="display:flex; align-items:baseline; gap:10px; flex-wrap:wrap">
                        <b>Abschnitte anordnen</b>
                        <span class="neben" style="display:inline">Die Reihenfolge gilt für alle Leser der Preisliste.</span>
                    </div>
                    <ol class="pl-anordnen-liste">
                        @for (var i = 0; i < _entwurf.Count; i++)
                        {
                            var idx = i;
                            var schluessel = _entwurf[i];
                            <li>
                                <span class="pl-anordnen-nr">@(i + 1)</span>
                                <span>
                                    @Titel(schluessel)
                                    @if (IstIntern(schluessel)) { <span class="pl-intern">intern</span> }
                                    @if (!vorhanden.Contains(schluessel)) { <span class="neben" style="display:inline; margin-left:6px">· derzeit ohne Inhalt</span> }
                                </span>
                                <span class="pl-anordnen-knoepfe">
                                    <button class="knopf sekundaer klein" disabled="@(idx == 0)" title="nach oben" @onclick="() => Verschieben(idx, -1)">▲</button>
                                    <button class="knopf sekundaer klein" disabled="@(idx == _entwurf.Count - 1)" title="nach unten" @onclick="() => Verschieben(idx, +1)">▼</button>
                                </span>
                            </li>
                        }
                    </ol>
                    <div class="formular-aktionen">
                        <button class="knopf" disabled="@_speichereReihenfolge" @onclick="ReihenfolgeSpeichernAsync">Speichern</button>
                        <button class="knopf sekundaer" @onclick="() => _anordnen = false">Abbrechen</button>
                        <button class="mehr" disabled="@_speichereReihenfolge" @onclick="StandardreihenfolgeAsync" title="Gespeicherte Reihenfolge verwerfen, Standard der Seite verwenden">Standardreihenfolge</button>
                    </div>
                </div>
            </div>
        }

        @* ---------- Abschnitte in der gespeicherten Reihenfolge ---------- *@
        @foreach (var schluessel in Reihenfolge())
        {
            @Abschnitt(schluessel, p)
        }
    }

    @* ---------- Bei uns: Zuständigkeit & Prozess ---------- *@
    <details class="gruppe" open>
        <summary>Bei uns — Zuständigkeit und Prozess</summary>
        <div class="gruppe-inhalt">
            @if (_info is null)
            {
                <div style="color:var(--muted)">Lade …</div>
            }
            else if (_infoBearbeiten)
            {
                <div class="formular">
                    <label>
                        Verantwortlich
                        <select @bind="_infoForm.VerantwortlichId">
                            <option value="">— offen —</option>
                            @foreach (var person in _personen) { <option value="@person.Id">@person.Name</option> }
                        </select>
                    </label>
                    <label>
                        Vertretung
                        <select @bind="_infoForm.VertreterId">
                            <option value="">— offen —</option>
                            @foreach (var person in _personen) { <option value="@person.Id">@person.Name</option> }
                        </select>
                    </label>
                    <label class="breit">
                        Prozess (wie entsteht eine neue Version, wer gibt frei, wo liegt sie?)
                        <textarea rows="5" @bind="_infoForm.Prozess"></textarea>
                    </label>
                </div>
                <div class="formular-aktionen">
                    <button class="knopf" @onclick="InfoSpeichernAsync">Speichern</button>
                    <button class="knopf sekundaer" @onclick="() => _infoBearbeiten = false">Abbrechen</button>
                </div>
            }
            else
            {
                <div class="sl-beiuns-zeile"><span class="sl-beiuns-label">Zuständig</span>
                    @if (_info.Verantwortlich is null) { <span class="warntext">noch nicht festgelegt</span> }
                    else { <span>@_info.Verantwortlich</span><span class="neben" style="display:inline">· Vertretung: @(_info.Vertreter ?? "offen")</span> }
                </div>
                <div class="sl-beiuns-zeile" style="align-items:flex-start"><span class="sl-beiuns-label">Prozess</span>
                    <span style="white-space:pre-wrap">@(_info.Prozess ?? "— noch nicht beschrieben")</span>
                </div>
                @if (_ansicht.DarfBearbeiten)
                {
                    <button class="knopf sekundaer klein" style="margin-top:8px" @onclick="InfoBearbeitenOeffnen">Bearbeiten</button>
                }
            }
        </div>
    </details>

    @if (_ansicht.Historie.Count > 1)
    {
        <details class="gruppe">
            <summary>Frühere Versionen<span class="zahl">@(_ansicht.Historie.Count - 1)</span></summary>
            <div class="gruppe-inhalt">
                @foreach (var v in _ansicht.Historie.Skip(1))
                {
                    <div class="zeile2">
                        <span><b>Version @v.Version</b> <span class="neben" style="display:inline; margin-left:6px">Stand @StandText(v.Stand) · importiert @v.ImportiertAm.ToLocalTime().ToString("dd.MM.yyyy")@(v.Notiz is not null ? $" · {v.Notiz}" : "")</span></span>
                        <button class="mehr" @onclick="() => LadenAsync(v.Version)">anzeigen</button>
                    </div>
                }
                @if (_ansicht.Version?.Version != _ansicht.Historie[0].Version)
                {
                    <button class="mehr" style="margin-top:6px" @onclick="() => LadenAsync(null)">zur aktuellen Version</button>
                }
            </div>
        </details>
    }
}

@code {
    private PreislisteAnsicht? _ansicht;
    private WikiThemaInfoEintrag? _info;
    private List<PersonAuswahl> _personen = [];
    private bool _infoBearbeiten;
    private readonly InfoFormular _infoForm = new();
    private IBrowserFile? _importDatei;
    private string _importNotiz = "";
    private bool _importiere;
    private bool _anordnen;
    private bool _speichereReihenfolge;
    private List<string> _entwurf = [];
    private string? _fehler;

    private class InfoFormular
    {
        public int? VerantwortlichId { get; set; }
        public int? VertreterId { get; set; }
        public string? Prozess { get; set; }
    }

    // ---------------------------------------------------------------------
    // Abschnitte der Seite. Schlüssel werden in WikiThemaInfo.Abschnitte
    // gespeichert (Redaktion ordnet an); die Reihenfolge hier ist der Standard.
    // Interne Abschnitte kommen für Unberechtigte gar nicht erst vom Server.
    // ---------------------------------------------------------------------
    private static readonly (string Schluessel, string Titel, bool Intern)[] StandardAbschnitte =
    [
        ("stufen", "Stufen und Volumenpreise", false),
        ("addons", "Add-ons und Module", false),
        ("pakete", "Sanktionslisten-Pakete", false),
        ("benutzer", "Benutzer-Pakete", false),
        ("worldcheck", "WorldCheck-Datenpakete", true),
        ("volumenpool", "Volume-Pool-Modell", true),
        ("begriffe", "Begriffe intern ↔ extern", false),
        ("vertriebshinweise", "Vertriebshinweise", true),
        ("sicherheit", "Sicherheit und Hosting", false),
        ("warum", "Warum ID.prove (Argumente)", false),
    ];

    private static readonly List<string> StandardSchluessel = StandardAbschnitte.Select(a => a.Schluessel).ToList();

    private static string Titel(string schluessel) => StandardAbschnitte.First(a => a.Schluessel == schluessel).Titel;
    private static bool IstIntern(string schluessel) => StandardAbschnitte.First(a => a.Schluessel == schluessel).Intern;

    private List<string> Reihenfolge() => WikiAbschnittReihenfolge.Anwenden(_info?.Abschnitte, StandardSchluessel);

    private RenderFragment? Abschnitt(string schluessel, PreislisteDaten p) => schluessel switch
    {
        "stufen" => Stufen(p),
        "addons" => Addons(p),
        "pakete" => p.SanktionslistenPakete is { } sp ? Pakete(sp) : null,
        "benutzer" => p.BenutzerStaffel is { } bs ? Benutzer(bs) : null,
        "worldcheck" => p.Worldcheck is { } wc ? Worldcheck(wc) : null,
        "volumenpool" => p.VolumenPool is { } vp ? VolumenPool(vp) : null,
        "begriffe" => p.Begriffe is { Count: > 0 } b ? Begriffe(b) : null,
        "vertriebshinweise" => p.Vertriebshinweise is { Count: > 0 } vh ? Vertriebshinweise(vh) : null,
        "sicherheit" => p.Sicherheit is { Count: > 0 } s ? Sicherheit(s) : null,
        "warum" => p.WarumIdprove is { Count: > 0 } w ? Warum(w, p.Onprem?.Text) : null,
        _ => null,
    };

    private RenderFragment Stufen(PreislisteDaten p) => @<details class="gruppe" open>
        <summary>Stufen und Volumenpreise<span class="zahl">@p.Stufen.Count Stufen · @p.Volumenstufen.Count Volumenstufen</span></summary>
        <div class="gruppe-inhalt">
            <div class="pl-stufen">
                @foreach (var s in p.Stufen)
                {
                    <div class="pl-stufe">
                        <div class="pl-stufe-name">@s.Name</div>
                        <div class="neben">@VolumenText(s)</div>
                        <dl class="werte" style="margin-top:8px">
                            <dt>Setup</dt><dd>@(s.SetupEinmalig?.Anzeige() ?? "—")@(s.SetupHinweis is not null ? $" · {s.SetupHinweis}" : "")
                                @if (s.SetupHinweisIntern is not null) { <span class="pl-intern">intern: @s.SetupHinweisIntern</span> }</dd>
                            <dt>Inklusive</dt><dd>@s.InklusiveBenutzer Benutzer · @s.InklusiveMandanten Mandanten</dd>
                        </dl>
                        <ul class="pl-merkmale">
                            @foreach (var m in s.Merkmale)
                            {
                                <li class="@(m.Enthalten ? "" : "nicht")">
                                    <span class="pl-zeichen">@(m.Enthalten ? "✓" : "–")</span>@m.Text
                                    @if (IstInternText(m.Sichtbarkeit)) { <span class="pl-intern">intern</span> }
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <table class="liste pl-tabelle" style="margin-top:14px">
                <thead>
                    <tr>
                        <th>Stammdaten</th>
                        @foreach (var s in p.Stufen) { <th class="r">@s.Name</th> }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in p.Volumenstufen)
                    {
                        <tr style="cursor:default">
                            <td>@(v.Label ?? v.Stammdaten.ToString("N0"))</td>
                            @foreach (var s in p.Stufen)
                            {
                                <td class="r">@(v.Preise.TryGetValue(s.Schluessel, out var w) ? w?.Anzeige() ?? "—" : "—")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
            @foreach (var r in p.VolumenRegeln ?? [])
            {
                <div class="pl-regel">@r.Text @if (IstInternText(r.Sichtbarkeit)) { <span class="pl-intern">intern</span> }</div>
            }
        </div>
    </details>;

    private RenderFragment Addons(PreislisteDaten p) => @<details class="gruppe" open>
        <summary>Add-ons und Module<span class="zahl">@p.Addons.Count</span></summary>
        <div class="gruppe-inhalt" style="padding:0">
            <table class="liste">
                <thead>
                    <tr><th>Add-on</th><th>Beschreibung</th><th style="width:170px">Verfügbar ab</th><th class="r" style="width:130px">Preis / Monat</th><th class="r" style="width:140px">Einrichtung</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in p.Addons)
                    {
                        <tr style="cursor:default">
                            <td>
                                <span class="haupt">@a.Name</span>
                                @if (IstInternText(a.Sichtbarkeit)) { <span class="pl-intern">intern</span> }
                                @if (a.NameIntern is not null) { <div class="neben">intern: @a.NameIntern</div> }
                            </td>
                            <td>
                                <span style="font-size:13px">@a.Beschreibung</span>
                                @if (a.HinweisIntern is not null) { <div class="neben pl-hinweis-intern">@a.HinweisIntern</div> }
                            </td>
                            <td>@StufenName(a.VerfuegbarAb)
                                @if (a.VerfuegbarkeitHinweis is not null) { <div class="neben">@a.VerfuegbarkeitHinweis</div> }
                            </td>
                            <td class="r">@(a.PreisMonat is null || a.PreisMonat.IstLeer ? "—" : a.PreisMonat.Zahl == 0 ? "inklusive" : a.PreisMonat.Anzeige())</td>
                            <td class="r">@(a.EinrichtungEinmalig is null || a.EinrichtungEinmalig.IstLeer ? "—" : a.EinrichtungEinmalig.Anzeige())
                                @if (a.EinrichtungHinweis is not null) { <div class="neben">@a.EinrichtungHinweis</div> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>;

    private RenderFragment Pakete(PreislistePakete sp) => @<details class="gruppe" open>
        <summary>Sanktionslisten-Pakete<span class="zahl">@sp.Pakete.Count Pakete · @sp.Standardlisten.Count Standardlisten</span></summary>
        <div class="gruppe-inhalt">
            @if (sp.Hinweis is not null) { <div class="pl-regel" style="margin-top:0">@sp.Hinweis</div> }
            <div class="pl-regel">Standardlisten (in allen Stufen): @string.Join(" · ", sp.Standardlisten)</div>
            <table class="liste pl-tabelle" style="margin-top:10px">
                <thead><tr><th>Paket</th><th style="width:60px">Listen</th><th class="r" style="width:120px">Preis / Monat</th><th>Enthaltene Listen</th></tr></thead>
                <tbody>
                    @foreach (var pk in sp.Pakete)
                    {
                        <tr style="cursor:default">
                            <td><span class="haupt">@pk.Name</span>@if (pk.NameIntern is not null) { <div class="neben">intern: @pk.NameIntern</div> }</td>
                            <td>@(pk.Listen.Count > 0 ? pk.Listen.Count.ToString() : "1")</td>
                            <td class="r">@(pk.PreisMonat?.Anzeige() ?? "—")</td>
                            <td style="font-size:13px">@(pk.Listen.Count > 0 ? string.Join(", ", pk.Listen) : "")@(pk.Hinweis is not null ? (pk.Listen.Count > 0 ? " — " : "") + pk.Hinweis : "")
                                — <a href="wiki/sanktionslisten">zum Sanktionslisten-Wiki</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </details>;

    private RenderFragment Benutzer(PreislisteBenutzer bs) => @<details class="gruppe" open>
        <summary>Benutzer-Pakete<span class="zahl">@bs.Stufen.Count Staffeln</span></summary>
        <div class="gruppe-inhalt">
            @if (bs.Hinweis is not null) { <div class="pl-regel" style="margin-top:0">@bs.Hinweis</div> }
            <table class="liste pl-tabelle" style="margin-top:10px; max-width:460px">
                <thead><tr><th>Benutzer-Anzahl</th><th class="r">Preis pro Benutzer / Monat</th></tr></thead>
                <tbody>
                    @foreach (var st in bs.Stufen)
                    {
                        <tr style="cursor:default"><td>@(st.Bis is null ? $"ab {st.Von}" : $"{st.Von} – {st.Bis}") Benutzer</td><td class="r">@(st.PreisProBenutzerMonat?.Anzeige() ?? "—")</td></tr>
                    }
                    @foreach (var pa in bs.Pauschalen ?? [])
                    {
                        <tr style="cursor:default"><td>@pa.Name@(pa.NurStufe is not null ? $" (nur {StufenName(pa.NurStufe)})" : "")</td><td class="r">@(pa.PreisMonat?.Anzeige(" pauschal") ?? "—")</td></tr>
                    }
                </tbody>
            </table>
            @foreach (var v in bs.Verkaufshilfen ?? [])
            {
                <div class="pl-regel">@v.Text @if (IstInternText(v.Sichtbarkeit)) { <span class="pl-intern">intern</span> }</div>
            }
        </div>
    </details>;

    private RenderFragment Begriffe(List<PreislisteBegriff> begriffe) => @<details class="gruppe" open>
        <summary>Begriffe intern ↔ extern<span class="zahl">@begriffe.Count</span></summary>
        <div class="gruppe-inhalt" style="padding:0">
            <table class="liste">
                <thead><tr><th style="width:220px">Bei uns</th><th style="width:260px">Beim Kunden</th><th>Erläuterung</th></tr></thead>
                <tbody>
                    @foreach (var b in begriffe)
                    {
                        <tr style="cursor:default"><td><span class="haupt">@b.Intern</span></td><td>@b.Extern</td><td style="font-size:13px">@(b.Erlaeuterung ?? "")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </details>;

    private RenderFragment Worldcheck(PreislisteWorldcheck wc) => @<details class="gruppe">
        <summary>WorldCheck-Datenpakete <span class="pl-intern">intern</span><span class="zahl">@wc.Pakete.Count Pakete</span></summary>
        <div class="gruppe-inhalt">
            @if (wc.Beschreibung is not null) { <div class="pl-regel" style="margin-top:0">@wc.Beschreibung</div> }
            @if (wc.VerfuegbarAb is not null) { <div class="pl-regel">Verfügbar ab @StufenName(wc.VerfuegbarAb)</div> }
            <div class="pl-stufen" style="margin-top:10px">
                @foreach (var pk in wc.Pakete)
                {
                    <div class="pl-stufe">
                        <div class="pl-stufe-name">@pk.Name</div>
                        @if (pk.Untertitel is not null) { <div class="neben">@pk.Untertitel</div> }
                        <table class="liste pl-tabelle" style="margin-top:8px">
                            <thead><tr><th>Stammdaten</th><th class="r">/ Monat</th><th class="r">/ Jahr</th></tr></thead>
                            <tbody>
                                @foreach (var st in pk.Staffel)
                                {
                                    <tr style="cursor:default"><td>@st.Stammdaten.ToString("N0")</td><td class="r">@(st.PreisMonat?.Anzeige() ?? "—")</td><td class="r">@(st.PreisJahr?.Anzeige() ?? "—")</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            @foreach (var r in wc.Regeln ?? []) { <div class="pl-regel">@r</div> }
        </div>
    </details>;

    private RenderFragment VolumenPool(PreislisteVolumenPool vp) => @<details class="gruppe">
        <summary>Volume-Pool-Modell <span class="pl-intern">intern</span><span class="zahl">@vp.Pools.Count Pools</span></summary>
        <div class="gruppe-inhalt">
            @if (vp.Beschreibung is not null) { <div class="pl-regel" style="margin-top:0">@vp.Beschreibung</div> }
            <table class="liste pl-tabelle" style="margin-top:10px">
                <thead><tr><th>Pool</th><th>Verwendung</th><th style="width:200px">Reset</th><th style="width:110px">Default</th></tr></thead>
                <tbody>
                    @foreach (var pool in vp.Pools)
                    {
                        <tr style="cursor:default"><td><span class="haupt">@pool.Name</span></td><td style="font-size:13px">@pool.Verwendung</td><td>@pool.Reset</td><td>@pool.Default</td></tr>
                    }
                </tbody>
            </table>
            @foreach (var h in vp.Hinweise ?? []) { <div class="pl-regel">@h</div> }
        </div>
    </details>;

    private RenderFragment Vertriebshinweise(List<PreislisteHinweis> hinweise) => @<details class="gruppe">
        <summary>Vertriebshinweise <span class="pl-intern">intern</span><span class="zahl">@hinweise.Count</span></summary>
        <div class="gruppe-inhalt">
            <dl class="pl-zeilen">
                @foreach (var h in hinweise)
                {
                    <dt>@h.Titel</dt>
                    <dd>@h.Text</dd>
                }
            </dl>
        </div>
    </details>;

    private RenderFragment Sicherheit(List<PreislisteSicherheit> sicherheit) => @<details class="gruppe">
        <summary>Sicherheit und Hosting<span class="zahl">@sicherheit.Count</span></summary>
        <div class="gruppe-inhalt">
            <dl class="pl-zeilen">
                @foreach (var s in sicherheit)
                {
                    <dt>@s.Thema</dt>
                    <dd>
                        @s.TextExtern
                        @if (s.TextIntern is not null && s.TextIntern != s.TextExtern)
                        {
                            <div class="pl-hinweis-intern"><span class="pl-intern" style="margin:0 6px 0 0">intern</span>@s.TextIntern</div>
                        }
                    </dd>
                }
            </dl>
        </div>
    </details>;

    private RenderFragment Warum(List<PreislisteHinweis> argumente, string? onprem) => @<details class="gruppe">
        <summary>Warum ID.prove (Argumente)<span class="zahl">@argumente.Count</span></summary>
        <div class="gruppe-inhalt">
            <dl class="pl-zeilen">
                @foreach (var w in argumente)
                {
                    <dt>@w.Titel</dt>
                    <dd>@w.Text</dd>
                }
            </dl>
            @if (onprem is not null) { <div class="pl-regel">@onprem</div> }
        </div>
    </details>;

    protected override Task OnInitializedAsync() => LadenAsync(null);

    private async Task LadenAsync(int? version)
    {
        _fehler = null;
        try
        {
            _ansicht = await Http.GetFromJsonAsync<PreislisteAnsicht>(
                version is null ? "api/wiki/preisliste" : $"api/wiki/preisliste?version={version}");
            _info = await Http.GetFromJsonAsync<WikiThemaInfoEintrag>("api/wiki/themen/preisliste/info");
            if (_ansicht?.DarfBearbeiten == true && _personen.Count == 0)
                _personen = await Http.GetFromJsonAsync<List<PersonAuswahl>>("api/wiki/personen") ?? [];
        }
        catch (Exception ex)
        {
            _fehler = $"Preisliste konnte nicht geladen werden: {ex.Message}";
        }
    }

    private void DateiGewaehlt(InputFileChangeEventArgs e) => _importDatei = e.File;

    private async Task ImportierenAsync()
    {
        if (_importDatei is null)
            return;
        _fehler = null;
        _importiere = true;
        try
        {
            using var inhalt = new MultipartFormDataContent();
            inhalt.Add(new StreamContent(_importDatei.OpenReadStream(5_000_000)), "datei", _importDatei.Name);
            inhalt.Add(new StringContent(_importNotiz), "notiz");
            var antwort = await Http.PostAsync("api/wiki/preisliste/import", inhalt);
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            _importDatei = null;
            _importNotiz = "";
            await LadenAsync(null);
        }
        catch (Exception ex)
        {
            _fehler = $"Import fehlgeschlagen: {ex.Message}";
        }
        finally
        {
            _importiere = false;
        }
    }

    // --- Abschnitte anordnen ------------------------------------------------

    private void AnordnenOeffnen()
    {
        _entwurf = Reihenfolge();
        _anordnen = true;
    }

    private void Verschieben(int index, int richtung)
    {
        var ziel = index + richtung;
        if (ziel < 0 || ziel >= _entwurf.Count)
            return;
        (_entwurf[index], _entwurf[ziel]) = (_entwurf[ziel], _entwurf[index]);
    }

    private Task ReihenfolgeSpeichernAsync() => ReihenfolgeSendenAsync(_entwurf);

    private Task StandardreihenfolgeAsync() => ReihenfolgeSendenAsync([]);

    private async Task ReihenfolgeSendenAsync(List<string> abschnitte)
    {
        _fehler = null;
        _speichereReihenfolge = true;
        try
        {
            var antwort = await Http.PutAsJsonAsync("api/wiki/themen/preisliste/abschnitte", new WikiAbschnitteSpeichern(abschnitte));
            if (!antwort.IsSuccessStatusCode)
            {
                _fehler = await antwort.Content.ReadAsStringAsync();
                return;
            }
            _anordnen = false;
            _info = await Http.GetFromJsonAsync<WikiThemaInfoEintrag>("api/wiki/themen/preisliste/info");
        }
        catch (Exception ex)
        {
            _fehler = $"Reihenfolge konnte nicht gespeichert werden: {ex.Message}";
        }
        finally
        {
            _speichereReihenfolge = false;
        }
    }

    // --- Zuständigkeit & Prozess -------------------------------------------

    private void InfoBearbeitenOeffnen()
    {
        _infoForm.VerantwortlichId = _info?.VerantwortlichId;
        _infoForm.VertreterId = _info?.VertreterId;
        _infoForm.Prozess = _info?.Prozess;
        _infoBearbeiten = true;
    }

    private async Task InfoSpeichernAsync()
    {
        _fehler = null;
        var antwort = await Http.PutAsJsonAsync("api/wiki/themen/preisliste/info",
            new WikiThemaInfoSpeichern(_infoForm.VerantwortlichId, _infoForm.VertreterId, _infoForm.Prozess));
        if (!antwort.IsSuccessStatusCode)
        {
            _fehler = await antwort.Content.ReadAsStringAsync();
            return;
        }
        _infoBearbeiten = false;
        _info = await Http.GetFromJsonAsync<WikiThemaInfoEintrag>("api/wiki/themen/preisliste/info");
    }

    private static bool IstInternText(string? s) => string.Equals(s, "intern", StringComparison.OrdinalIgnoreCase);

    private string StufenName(string? schluessel) =>
        _ansicht?.Daten?.Stufen.FirstOrDefault(s => s.Schluessel == schluessel)?.Name ?? schluessel ?? "—";

    private static string VolumenText(PreislisteStufe s) =>
        s.VolumenHinweis ?? (s.VolumenBis is null
            ? $"ab {s.VolumenVon:N0} Stammdaten"
            : $"{s.VolumenVon:N0} – {s.VolumenBis:N0} Stammdaten");

    private static string StandText(string stand) =>
        DateOnly.TryParseExact(stand + "-01", "yyyy-MM-dd", out var d) ? d.ToString("MMMM yyyy", new System.Globalization.CultureInfo("de-DE")) : stand;

    private static string OrdnerLink(string ordner)
    {
        try { return new Uri(ordner).AbsoluteUri; }
        catch { return ""; }
    }
}
