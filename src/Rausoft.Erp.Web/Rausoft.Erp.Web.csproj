<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Kein Asset-Fingerprinting: beim Publish über das API-Projekt (gehostetes
         Frontend, DEPLOYMENT Weg A) wird der index.html-Platzhalter nicht ersetzt
         und die App bleibt bei "wird geladen" hängen. Klassische Dateinamen sind
         für den Intranet-Betrieb die robuste Wahl. -->
    <StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rausoft.Erp.Dtos\Rausoft.Erp.Dtos.csproj" />
  </ItemGroup>

</Project>
